      "question": "What is the cross-reactivity risk?",
      "method": "ClusPro docking against SARS-CoV-2/HIV-1/RSV F",
      "output": "Average binding energy, risk level"
    },
    {
      "stage": 4,
      "question": "Can the binding mode be refined?",
      "method": "HADDOCK 2.5 semi-flexible refinement",
      "output": "HADDOCK score, cluster, BSA"
    },
    {
      "stage": 5,
      "question": "Which residues drive the interface?",
      "method": "PyMOL + SPICE",
      "output": "Contacts, hydrogen bonds, salt bridges, hydrophobic interactions"
    },
    {
      "stage": 6,
      "question": "Is the complex stable under physiological conditions?",
      "method": "GROMACS 100 ns MD",
      "output": "RMSD, RMSF, Rg, hydrogen bonds"
    },
    {
      "stage": 7,
      "question": "What are the binding free energy and hotspots?",
      "method": "gmx_MMPBSA + per-residue decomposition",
      "output": "ΔG_bind, hotspot residues"
    }
