# ======================================
# 通用忽略项（所有项目必用）
# ======================================
# 日志文件
*.log
*.logs
logs/
# 临时/缓存文件
*.tmp
*.temp
*.swp
*.swo
*.bak
*~
# 构建输出目录
dist/
build/
out/
output/
# 环境变量/配置文件（敏感信息）
.env
.env.*
!.env.example  # 保留示例环境文件
# 证书/密钥文件
*.pem
*.key
*.crt
*.pub
# 压缩包
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
# 数据库文件
*.db
*.sqlite
*.sqlite3
*.sql

# ======================================
# 操作系统专属忽略
# ======================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
ehthumbs.db
# Linux
*~

# ======================================
# IDE / 编辑器专属忽略
# ======================================
# VS Code
.vscode/
*.code-workspace
# IntelliJ IDEA / PyCharm / Goland
.idea/
*.iml
*.iws
*.ipr
# Eclipse
.project
.classpath
.metadata/
# Visual Studio
.vs/
*.suo
# Sublime Text
*.sublime-workspace
# Vim
.*.sw?

# ======================================
# SZPU-2026 Wiki 项目专属
# ======================================
/docs/
/dogfood-output/
*.md

# 排除脚本与数据文件，但保留静态网页资源目录中的同名文件
*.csv
*.ps1
*.py
*.json
!static/**/*.csv
!static/**/*.ps1
!static/**/*.py
!static/**/*.json

#工具状态与配置
.superpowers/
.trae/
.codebuddy/

# ======================================
# 编程语言 & 框架专属忽略
# ======================================
# 1. Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.tox/
.coverage
.pytest_cache/
.mypy_cache/
# 2. Node.js / JavaScript / 前端(React/Vue/Next)
node_modules/

# 对话过程产生的研究、测试、截图与临时文件
对话归档/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/
.parcel-cache/
# 3. Java / Kotlin / Maven / Gradle
*.class
*.jar
*.war
target/
.gradle/
!gradle/wrapper/gradle-wrapper.jar
# 4. Go
/bin/
/vendor/
*.exe
*.dll
*.so
# 5. PHP
vendor/
composer.lock
.php-cs-fixer.cache
# 6. C# / .NET
[Bb]in/
[Oo]bj/
# 7. Ruby
/vendor/bundle
.bundle/
Gemfile.lock

# ======================================


# === 对话产物 / 工具生成文件（不入库） ===
/对话归档/
.playwright-cli/

# 保留项目指导文档（否则会被上方的 *.md 规则忽略）
!README.md

# 保留正式治理契约与台账（否则会被上方的 *.md 规则忽略）
!AGENTS.md
!DOCUMENT_MAP.md
!Requirements/
!Requirements/**
!Decisions/
!Decisions/**
# Progress/ 改为 git 忽略（物理保留，入库干净），不再强制跟踪

# 对话归档必须始终忽略；此规则置于 README 例外之后以覆盖其内部说明文件
/对话归档/

# 根目录工程化脚本（构建/验证工具）需入库：package.json 的 build:all / test:smoke 直接调用，CI 需要这些文件才能构建，不能再忽略

# 保留 Node 依赖声明，便于重新生成搜索索引
!package.json
!package-lock.json

# 本地预览产物（非源码，不入库）
site-preview/
.originkit/

# 第三方 PDF.js 库：由 iGEM 官方 CDN 提供，不入库（本地物理保留供开发调试）
static/js/pdfjs/

# 加载遮罩插画（page-loader）：CSS 实际只加载 loader-sprite@2x.webp，
# 逐帧导出 loader-frame-*.webp 与 1x 雪碧图 loader-sprite.webp 是同源冗余副本（全仓库 0 引用），不入库（本地物理保留）。
# 若连 @2x 也不入库（部署站加载动画退回纯 CSS 三点兜底），取消下一行注释即可：
/static/image/loader/loader-frame-*.webp
/static/image/loader/loader-sprite.webp
# /static/image/loader/loader-sprite@2x.webp

# 团队活动照片池：106 MB / 346 张，全仓库 0 引用（不为任何页面/CSS/JS 加载），不入库（本地物理保留）
/static/image/team-photo/

# 源图片工作区：`static/image/**/源图片/` 存放原图（character 下 38 个 / 48.5 MB），
# 是页面引用资源的**上游素材**，不是运行资源本身。页面只引用同素材目录 `webp/` 下的
# 转换产物（长边 ≤ 1920px、质量 82–88）。原图不入库（本地物理保留），
# 与 §17.2「只入库被引用且唯一的那一份」一致。见 README 第 17.2 / 17.3 节。
/static/image/**/源图片/

# 实验方案素材目录：`static/expriments/` 存放各功能模块的方案文档（.md）、原始 docx
# 与实验影像素材，是**分析材料**而非站点运行资源——全仓库 0 引用，且不经 Eleventy
# 构建（input 只到 `src/`）。整目录不入库，本地物理保留。
# 见 README 第 5.14 节（四模块映射）与第 17.2 节（入库边界）。
/static/expriments/
