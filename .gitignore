# ======================================
# 通用忽略项（所有项目必用）
# ======================================
# 日志文件
*.log
*.logs
logs/
# 临时/缓存文件
*.tmp
*.temp
*.swp
*.swo
*.bak
*~
# 构建输出目录
dist/
build/
out/
output/
# 环境变量/配置文件（敏感信息）
.env
.env.*
!.env.example  # 保留示例环境文件
# 证书/密钥文件
*.pem
*.key
*.crt
*.pub
# 压缩包
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
# 数据库文件
*.db
*.sqlite
*.sqlite3
*.sql

# ======================================
# 操作系统专属忽略
# ======================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
ehthumbs.db
# Linux
*~

# ======================================
# IDE / 编辑器专属忽略
# ======================================
# VS Code
.vscode/
*.code-workspace
# IntelliJ IDEA / PyCharm / Goland
.idea/
*.iml
*.iws
*.ipr
# Eclipse
.project
.classpath
.metadata/
# Visual Studio
.vs/
*.suo
# Sublime Text
*.sublime-workspace
# Vim
.*.sw?

# ======================================
# SZPU-2026 Wiki 项目专属
# ======================================
/docs/
/dogfood-output/
*.md

# 排除脚本与数据文件，但保留静态网页资源目录中的同名文件
*.csv
*.ps1
*.py
*.json
!static/**/*.csv
!static/**/*.ps1
!static/**/*.py

#工具状态与配置
.superpowers/
.trae/
.codebuddy/

# ======================================
# 编程语言 & 框架专属忽略
# ======================================
# 1. Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.tox/
.coverage
.pytest_cache/
.mypy_cache/
# 2. Node.js / JavaScript / 前端(React/Vue/Next)
node_modules/

# 对话过程产生的研究、测试、截图与临时文件
对话归档/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/
.parcel-cache/
# 3. Java / Kotlin / Maven / Gradle
*.class
*.jar
*.war
target/
.gradle/
!gradle/wrapper/gradle-wrapper.jar
# 4. Go
/bin/
/vendor/
*.exe
*.dll
*.so
# 5. PHP
vendor/
composer.lock
.php-cs-fixer.cache
# 6. C# / .NET
[Bb]in/
[Oo]bj/
# 7. Ruby
/vendor/bundle
.bundle/
Gemfile.lock

# ======================================


# === 对话产物 / 工具生成文件（不入库） ===
/对话归档/
.playwright-cli/

# 保留项目指导文档（否则会被上方的 *.md 规则忽略）
!README.md

# 保留正式治理契约与台账（否则会被上方的 *.md 规则忽略）
!AGENTS.md
!DOCUMENT_MAP.md
!Requirements/
!Requirements/**
!Decisions/
!Decisions/**
!Progress/
!Progress/**

# 对话归档必须始终忽略；此规则置于 README 例外之后以覆盖其内部说明文件
/对话归档/

# 保留 Node 依赖声明，便于重新生成搜索索引
!package.json
!package-lock.json

# 本地预览产物（非源码，不入库）
site-preview/
