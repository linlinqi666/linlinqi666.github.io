---
permalink: "team/members.html"
title: "Members - iGEM SZPU-2026"
lang: "en"
basePath: "../"
css:
  - static/css/members.css
headExtraPartial: "head-extra/team-members.njk"
js:
  - static/js/pages/members.js
  - static/js/components/members-intro.js
---

{% extends "layouts/base.njk" %}

{% block main %}
<!-- 页面唯一 h1：视觉上由条带标题 / 引导封面承担，这里为屏幕阅读器保留语义标题 -->
<h1 class="members-sr-only">Team Members</h1>

<!-- 全屏引导封面（默认 display:none；由 <head> 内同步 arm 脚本给 <html> 加
     members-intro-armed 后才显示）。点击任意处 / Enter / Space / Esc 进入成员页。
     无 JS 时不 arm，页面内容直接可见；脚本失败时由 arm 脚本内 8s 看门狗兜底。 -->
<div class="members-intro" id="members-intro" role="dialog" aria-modal="true" aria-label="Team introduction">
  <div class="members-intro__media" aria-hidden="true">
    <span class="members-intro__backdrop"></span>
    <img class="members-intro__photo" id="members-intro-photo" data-critical loading="eager" fetchpriority="high"
      decoding="async" alt="SZPU-China 2026 team photo"
      src="../static/image/any-icon/character/webp/total.webp"
      srcset="../static/image/any-icon/character/webp/total-960.webp 960w, ../static/image/any-icon/character/webp/total.webp 1919w"
      sizes="100vw">
    <span class="members-intro__shade"></span>
  </div>
  <div class="members-intro__panel">
    <p class="members-intro__eyebrow">SZPU-China · iGEM 2026</p>
    <p class="members-intro__title">Meet the Team</p>
    <button type="button" class="members-intro__enter" id="members-intro-enter">
      Enter the team<span aria-hidden="true">→</span>
    </button>
    <p class="members-intro__hint">Click anywhere · or press Enter</p>
  </div>
</div>

<div id="members-redesign-app" class="members-redesign-app">
      <!-- 中间人物大背景图容器：由 JS updateBackground() 切换 -->
      <div class="members-bg-layer" aria-hidden="true">
        <div class="bg-slide bg-slide-a is-active"></div>
        <div class="bg-slide bg-slide-b"></div>
        <div class="bg-mask"></div>
      </div>
      <aside class="members-strip" id="members-strip" aria-label="Member navigation">
        <div class="strip-header">
          <h2 class="strip-title">Team Members</h2>
          <button class="strip-toggle" id="strip-toggle" aria-label="Toggle member list" aria-expanded="false">
            <span class="strip-toggle-arrow" aria-hidden="true">&#x25BC;</span>
          </button>
        </div>
        <div class="strip-groups" id="strip-groups"></div>
      </aside>
      <section class="members-detail" id="members-detail" aria-live="polite" aria-atomic="true">
        <div class="detail-card" id="detail-card" hidden>
          <div class="detail-content">
            <h3 class="detail-name" id="detail-name"></h3>
            <p class="detail-role" id="detail-role"></p>
            <div class="detail-tags detail-role-tags" id="detail-role-tags"></div>
            <div class="detail-tags detail-direction-tags" id="detail-direction-tags"></div>
            <div class="detail-bio" id="detail-bio"></div>
          </div>
        </div>
      </section>
      <!-- 右侧人物简介条带：与左侧条带等拉伸高度，支持向右拖动收起 -->
      <aside class="bio-rail" id="bio-rail" aria-label="Member info">
        <div class="rail-edge-filler" id="rail-edge-filler" aria-hidden="true"></div>
        <button class="rail-toggle" id="rail-toggle" aria-label="Show member info" aria-expanded="false">
          <span class="rail-toggle-icon" aria-hidden="true">&#x25C0;</span>
        </button>
        <div class="bio-rail-inner">
          <div class="rail-scroll">
            <h3 class="rail-name" id="rail-name"></h3>
            <p class="rail-role" id="rail-role"></p>
            <div class="rail-tags rail-role-tags" id="rail-role-tags"></div>
            <div class="rail-tags rail-direction-tags" id="rail-direction-tags"></div>
            <p class="rail-bio" id="rail-bio"></p>
          </div>
        </div>
      </aside>
    </div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    new PageProgressBar().startAutoProgress();
  
  });
</script>
{% endblock %}
