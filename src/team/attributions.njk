---
permalink: "team/attributions.html"
title: "Attributions - iGEM SZPU-2026"
lang: "en"
mainClass: "attributions-main"
basePath: "../"
css:
  - static/css/attributions.css
js:
  - static/js/pages/attributions.js
---

{% extends "layouts/base.njk" %}

{% block main %}
<div class="attributions-container">
      <h1 class="sr-only">Attributions - iGEM SZPU-2026</h1>

      <!-- Jump to 导航 -->
      <section class="jump-to-nav">
        <div class="jump-to-header">
          <span class="jump-to-label">Quick Navigation</span>
        </div>
        <div class="jump-to-buttons">
          <a href="#team-contributions" class="jump-to-btn">
            <span class="step-num">01</span>
            <span>Team Members</span>
          </a>
          <a href="#ai-tools" class="jump-to-btn">
            <span class="step-num">02</span>
            <span>AI Tools</span>
          </a>
          <a href="#external-contributions" class="jump-to-btn">
            <span class="step-num">03</span>
            <span>External Support</span>
          </a>
          <a href="#timeline" class="jump-to-btn">
            <span class="step-num">04</span>
            <span>Project Timeline</span>
          </a>
        </div>
      </section>

      <!-- 01 团队成员贡献 -->
      <section id="team-contributions" class="section section-member">
        <figure class="page-mascot page-mascot--attributions" aria-hidden="true">
          <img src="../static/image/any-icon/extension/attributions.png" alt="" width="440" height="456"
            loading="lazy" decoding="async">
        </figure>

        <div class="section-header">
          <div class="section-title-wrapper">
            <h2 class="section-title">Team Member Contributions</h2>
          </div>
          <p class="section-description">Every member of SZPU-2026 and the tasks recorded for them on the attribution
            form. Hover a task tag to read the official definition of that task.</p>
        </div>

        <!-- 角色分类标签 -->
        <div class="role-tabs">
          {% for group in attribution.memberGroups %}
          <button class="role-tab{% if loop.first %} active{% endif %}" data-role="{{ group.key }}">{{ group.label }}</button>
          {% endfor %}
        </div>

        <div class="members-grid" id="members-grid">
          {% for member in attribution.members %}
          <div class="member-card" data-role="{{ member.group }}">
            <div class="member-header">
              <div class="member-avatar avatar-{{ member.group }}">
                {% if member.avatar %}
                <img loading="lazy" src="../static/image/any-icon/character/webp/{{ member.avatar }}.webp"
                  alt="{{ member.name }}" style="width:100%;height:100%;object-fit:cover;" />
                {% else %}
                <span class="member-avatar-initial">{{ member.initials }}</span>
                {% endif %}
              </div>
              <div class="member-info">
                <h3>{{ member.name }}</h3>
                <p class="member-role">
                  <span class="role-badge badge-{{ member.group }}">{{ member.title }}</span>
                  {% if member.focus %}<span class="member-focus">{{ member.focus }}</span>{% endif %}
                </p>
              </div>
            </div>
            {% if member.tasks.length %}
            <div class="tasks-section">
              <span class="tasks-label">Key Tasks</span>
              <div class="tasks-tags">
                {% for task in member.tasks %}
                <span class="task-tag" data-detail="{{ attribution.taskDefs[task] }}">{{ task }}</span>
                {% endfor %}
              </div>
            </div>
            {% endif %}
            {% if member.specifics.length %}
            <div class="specific-tasks-section">
              <span class="specific-tasks-label">Specific Contributions</span>
              {% if member.hasLabels %}
              <ul class="specific-list">
                {% for item in member.specifics %}
                <li class="specific-item">
                  <span class="specific-item-label">{{ item.label }}</span>
                  <span class="specific-item-text">{{ item.text }}</span>
                </li>
                {% endfor %}
              </ul>
              {% else %}
              <p class="specific-tasks-content">{{ member.firstSpecific }}</p>
              {% endif %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>

      </section>

      <!-- 02 AI 工具 -->
      <section id="ai-tools" class="section section-ai">
        <div class="section-header">
          <div class="section-title-wrapper">
            <h2 class="section-title">AI Tools</h2>
          </div>
          <p class="section-description">Every AI tool the team used, what each was used for, and where it was not
            allowed to replace our own work</p>
        </div>

        <div class="ai-grid">
          {% for tool in attribution.aiTools %}
          <article class="ai-card">
            <div class="ai-card-head">
              <h3 class="ai-name">{{ tool.name }}</h3>
              <span class="ai-kind">{{ tool.kind }}</span>
            </div>
            <div class="tasks-tags">
              {% for task in tool.tasks %}
              <span class="task-tag" data-detail="{{ attribution.taskDefs[task] }}">{{ task }}</span>
              {% endfor %}
            </div>
            {% for block in tool.blocks %}
            <div class="ai-block">
              {% if block.label %}<span class="ai-block-label">{{ block.label }}</span>{% endif %}
              <p class="ai-block-text">{{ block.text }}</p>
            </div>
            {% endfor %}
          </article>
          {% endfor %}
        </div>
      </section>

      <!-- 03 外部贡献 -->
      <section id="external-contributions" class="section section-external">
        <div class="section-header">
          <div class="section-title-wrapper">
            <h2 class="section-title">External Contributions</h2>
          </div>
          <p class="section-description">{{ attribution.externalCounts.total }} contributors outside the team — advisers,
            collaborating schools and teams, public databases and open-source software — whose input or tools shaped
            how this project was designed, built or explained</p>
        </div>

        <!-- 关系类型过滤按钮 -->
        <div class="external-type-filter">
          {% for filter in attribution.externalFilters %}
          <button class="type-filter-btn{% if loop.first %} active{% endif %}" data-rel="{{ filter.key }}">{{ filter.label }}</button>
          {% endfor %}
        </div>

        <div class="external-grid" id="external-grid">
          {% for item in attribution.external %}
          <article class="external-card" data-rel="{{ item.relationship }}">
            <div class="external-title-area">
              <h3 class="external-name">{{ item.name }}</h3>
              <div class="external-meta">
                <span class="meta-label">Institution:</span>
                <span class="meta-value">{{ item.institutionType }}</span>
              </div>
              <div class="external-meta">
                <span class="meta-label">Relationship:</span>
                <span class="meta-value">{{ item.relationship }}</span>
              </div>
            </div>
            <div class="ext-compact-block">
              <span class="ext-compact-label">Tasks</span>
              <div class="tasks-tags">
                {% for task in item.tasks %}
                <span class="task-tag" data-detail="{{ attribution.taskDefs[task] }}">{{ task }}</span>
                {% endfor %}
              </div>
            </div>
            <div class="ext-compact-block">
              <span class="ext-compact-label">Specific Contributions</span>
              {% for detail in item.details %}
              <p class="ext-detail"><span class="ext-detail-label">{{ detail.label }}</span>{{ detail.text | safe }}</p>
              {% endfor %}
            </div>
          </article>
          {% endfor %}
        </div>

        <!-- 致谢横幅 -->
        <div class="acknowledgment-banner">
          <div class="ack-content">
            <div>
              <h4>Special Acknowledgments</h4>
              <p>The contributions above are not only individual advisers. They also include the schools, host
                institutions and iGEM teams that shared protocols, equipment and results with us; the funding bodies
                that paid for reagents, sequencing and travel; and the public databases and open-source software
                without which neither our constructs nor the models on this Wiki could have been built. To every
                person, team, sponsor and tool on this page: thank you.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 项目时间线 -->
      <section id="timeline" class="section section-timeline">
        <div class="section-header">
          <div class="section-title-wrapper">
            <h2 class="section-title">Project Timeline</h2>
          </div>
          <p class="section-description">The five phases reported on our attribution form, from first recruitment to the
            Wiki freeze — <span class="timeline-hint">click a bar for details</span></p>
        </div>

        <div class="timeline-section">
          <div class="timeline-container">
            <div class="timeline" id="timeline-chart">
              <div class="timeline-header">
                <div class="timeline-task-label">Project phase</div>
                <div class="timeline-months">
                  {% for month in attribution.timelineMonths %}
                  <div class="timeline-month">
                    {% if month.year %}<span class="timeline-month-year">{{ month.year }}</span>{% endif %}
                    <span>{{ month.label }}</span>
                  </div>
                  {% endfor %}
                </div>
              </div>

              {% for phase in attribution.phases %}
              <div class="timeline-row">
                <div class="timeline-task-name">
                  <span class="timeline-task-text">{{ phase.label }}</span>
                </div>
                <div class="timeline-bar-container">
                  <div class="timeline-grid-lines">
                    {% for i in range(0, 13) %}
                    <div class="timeline-grid-line" style="left: {{ (loop.index * 100 / 14) | round(3) }}%"></div>
                    {% endfor %}
                  </div>
                  <div class="timeline-bar tone-{{ phase.tone }}" style="left: {{ phase.left }}%; width: {{ phase.width }}%;"
                    data-start="{{ phase.startLabel }}" data-end="{{ phase.endLabel }}"
                    data-duration="{{ phase.calendarLabel }}" data-worked="{{ phase.workedLabel }}"
                    data-description="{{ phase.description }}">
                    <span class="timeline-bar-duration">{{ phase.barLabel }}</span>
                  </div>
                </div>
              </div>
              {% endfor %}

              <div class="timeline-legend">
                <div class="legend-item">
                  <span class="legend-bar"></span>
                  <span class="legend-text">Calendar duration of the phase</span>
                </div>
                <div class="legend-tip">
                  Click any bar to view start, end, calendar duration and actual time worked
                </div>
              </div>

              <!-- Tooltip -->
              <div class="timeline-tooltip" id="timeline-tooltip">
                <div class="tooltip-arrow"></div>
                <div class="timeline-tooltip-header">
                  <span class="timeline-tooltip-header-text" id="tooltip-title">Activity Details</span>
                </div>

                <div class="timeline-tooltip-slider">
                  <div class="timeline-tooltip-panel panel-current" id="panel-current">
                    <div class="timeline-tooltip-body">
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Start</span>
                        <span class="timeline-tooltip-value" id="tooltip-start">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">End</span>
                        <span class="timeline-tooltip-value" id="tooltip-end">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Calendar</span>
                        <span class="timeline-tooltip-value" id="tooltip-duration">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Worked</span>
                        <span class="timeline-tooltip-value" id="tooltip-worked">—</span>
                      </div>
                      <div class="timeline-tooltip-row tooltip-desc-row">
                        <span class="timeline-tooltip-label">Details</span>
                        <div class="timeline-tooltip-value tooltip-desc" id="tooltip-description">—</div>
                      </div>
                    </div>
                  </div>
                  <div class="timeline-tooltip-panel panel-incoming" id="panel-incoming" aria-hidden="true">
                    <div class="timeline-tooltip-body">
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Start</span>
                        <span class="timeline-tooltip-value" id="tooltip-start-2">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">End</span>
                        <span class="timeline-tooltip-value" id="tooltip-end-2">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Calendar</span>
                        <span class="timeline-tooltip-value" id="tooltip-duration-2">—</span>
                      </div>
                      <div class="timeline-tooltip-row">
                        <span class="timeline-tooltip-label">Worked</span>
                        <span class="timeline-tooltip-value" id="tooltip-worked-2">—</span>
                      </div>
                      <div class="timeline-tooltip-row tooltip-desc-row">
                        <span class="timeline-tooltip-label">Details</span>
                        <div class="timeline-tooltip-value tooltip-desc" id="tooltip-description-2">—</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="tooltip-close-hint">Click any bar again to close</div>
              </div>
            </div>
          </div>
        </div>

        <p class="timeline-note"><strong>Calendar duration</strong> is computed from the start and end date of each
          phase. <strong>Actual time worked</strong> is our own estimate of real effort, reported separately on the
          attribution form — it is not elapsed calendar time, because the modules ran in parallel and most members were
          not full-time on any single phase.</p>

        <div class="timeline-table-wrap">
          <table class="timeline-table">
            <caption>Phase summary</caption>
            <thead>
              <tr>
                <th scope="col">Phase</th>
                <th scope="col">Start</th>
                <th scope="col">End</th>
                <th scope="col">Calendar</th>
                <th scope="col">Actual time worked</th>
              </tr>
            </thead>
            <tbody>
              {% for phase in attribution.phases %}
              <tr>
                <th scope="row">{{ phase.label }}</th>
                <td>{{ phase.startLabel }}</td>
                <td>{{ phase.endLabel }}</td>
                <td>{{ phase.calendarLabel }}</td>
                <td>{{ phase.workedLabel }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    </div>
{% endblock %}
