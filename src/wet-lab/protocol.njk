{# This page (reverted 2026-09-30, fine-tuned): restored to a single embedded
   protocol.pdf — no sidebar, no large hero title; an intro card explains the
   page purpose and the PDF is wrapped by a content-card (styles live in the
   .protocol-page scope of pdf-embed.css). Since 2026-10-07 the #toolbar=0 flag
   is dropped to restore basic reader controls. The split version (6 sections /
   22 headings) is deprecated; the full PDF is hosted on static.igem.wiki.
   Changes must stay in sync with Flask wiki/pages/protocol.html. #}
{% extends "layouts/base.njk" %}

{% block main %}
<main class="pdf-page protocol-page">
  <section class="content-card protocol-intro" aria-labelledby="protocol-intro-title">
    <h2 id="protocol-intro-title">Protocol</h2>

    <p>
      The full wet-lab protocols of the PAGER-Yeast project are provided here as a
      single handbook (PDF, 47 pages), covering the complete experimental pipeline of
      the project: molecular cloning in E. coli, yeast transformation, CRISPR-Cas9
      chassis engineering, reporter assays, and sensor validation experiments.
    </p>
  </section>
  <section class="content-card" aria-label="Protocol document">
    {% set pdfUrl = "https://static.igem.wiki/teams/6373/wiki/lab/wetlab/protocol/protocol.pdf" %}
    {% set pdfLabel = "Protocol (PDF, 47 pages)" %}
    {% set pdfFallback = "This protocol PDF is not available yet." %}
    {% include "partials/pdf-embed.njk" %}
  </section>
</main>
{% endblock %}
