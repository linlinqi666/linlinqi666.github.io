{% extends "layouts/base.njk" %}

{% block main %}
<div class="description-container notebook-page">
  <aside class="description-sidebar">
    <div class="yeast-decoration">
      <div class="yeast-cell yeast-cell-1"></div>
      <div class="yeast-cell yeast-cell-2"></div>
      <div class="yeast-cell yeast-cell-3"></div>
      <div class="bubble bubble-1"></div>
      <div class="bubble bubble-2"></div>
      <div class="bubble bubble-3"></div>
    </div>

    <div class="description-nav-wrapper">
      <ul class="description-nav">
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#notebook-overview" class="nav-main-link">Notebook Overview</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#notebook-chassis" class="nav-main-link">Chassis Engineering</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#notebook-gpa1" class="nav-main-link">Humanized G-Protein Chimera</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#notebook-pager" class="nav-main-link">PAGER Fusion Receptor</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#notebook-reporter" class="nav-main-link">Reporter Module</a>
          </div>
        </li>
      </ul>
    </div>
  </aside>

  <div class="description-content">
    <div id="notebook-overview" class="content-card">
      <figure class="page-mascot page-mascot--notebook" aria-hidden="true">
        <img src="../static/image/any-icon/extension/notebook.png" alt="" width="440" height="482"
          loading="lazy" decoding="async">
      </figure>
      <h2>Notebook</h2>
      <p class="content-intro">
        These notebooks serve as the main entry for our wet-lab documentation of the yeast-based biosensor targeting airborne influenza A virus (IAV). Our PAGER (Protein-fragment Assisted GPCR Expression Reporter) antigen-gated receptor system is built in four independent functional modules. Below you can access experimental records for chassis engineering, humanized G-protein chimera construction, PAGER fusion-receptor assembly, and reporter-module validation respectively. Each record links to the Protocol page, and to external resources cited inside the document.
      </p>
    </div>

    <div id="notebook-chassis" class="content-card">
      <h2>Chassis Engineering</h2>
      <p class="content-intro">
        This notebook records wet-lab procedures for chassis optimization of our yeast biosensor. We performed CRISPR-Cas9-mediated knockout of endogenous FAR1 and SST2 in <i>Saccharomyces cerevisiae</i> BY4741, aiming to eliminate cell-cycle arrest and G-protein-signaling negative feedback, so as to improve signal sensitivity for our downstream PAGER antigen-gated receptor system.
      </p>
      {% set pdfUrl = "https://static.igem.wiki/teams/6373/wiki/lab/wetlab/notebook/notebook-chassis-far1-sst2-knockout.pdf" %}
      {% set pdfLabel = "Notebook - Construction of the FAR1/SST2 Knockout Yeast Strain" %}
      {% set pdfFallback = "This notebook PDF is not available yet." %}
      {% include "partials/pdf-embed.njk" %}
      <div class="notebook-resources">
        <a class="notebook-resources__protocol" href="protocol.html">Protocol: Chassis Engineering →</a>
        <span class="notebook-resources__label">Resources in document:</span>
        <a href="https://www.yeastgenome.org/" target="_blank" rel="noopener">SGD</a>
        <a href="https://www.benchling.com" target="_blank" rel="noopener">Benchling</a>
      </div>
    </div>

    <div id="notebook-gpa1" class="content-card">
      <h2>Humanized G-Protein Chimera</h2>
      <p class="content-intro">
        This notebook records the humanization engineering of GPA1 in <i>Saccharomyces cerevisiae</i> — replacing the native C-terminal KIGII motif with the human Gαq EYNLV sequence to retune G-protein coupling for the PAGER receptor.
      </p>
      {% set pdfUrl = "https://static.igem.wiki/teams/6373/wiki/lab/wetlab/notebook/notebook-gpa1-humanization.pdf" %}
      {% set pdfLabel = "Notebook - Humanization Engineering of GPA1 in Saccharomyces cerevisiae" %}
      {% set pdfFallback = "This notebook PDF is not available yet." %}
      {% include "partials/pdf-embed.njk" %}
      <div class="notebook-resources">
        <a class="notebook-resources__protocol" href="protocol.html">Protocol: Humanized G-Protein Chimera →</a>
      </div>
    </div>

    <div id="notebook-pager" class="content-card">
      <h2>PAGER Fusion Receptor</h2>
      <p class="content-intro">
        This notebook records the construction of the PAGER antigen-gated system for Influenza A virus detection — assembly of the membrane-anchored scFv–Gα–Gγ fusion receptor, yeast transformation, expression validation, and HA-antigen-induced activation detection.
      </p>
      {% set pdfUrl = "https://static.igem.wiki/teams/6373/wiki/lab/wetlab/notebook/notebook-pager-antigen-gated.pdf" %}
      {% set pdfLabel = "Notebook - Construction of the PAGER Antigen-Gated System for Influenza A Virus Detection" %}
      {% set pdfFallback = "This notebook PDF is not available yet." %}
      {% include "partials/pdf-embed.njk" %}
      <div class="notebook-resources">
        <a class="notebook-resources__protocol" href="protocol.html">Protocol: PAGER Fusion Receptor →</a>
      </div>
    </div>

    <div id="notebook-reporter" class="content-card">
      <h2>Reporter Module</h2>
      <p class="content-intro">
        This notebook records the construction and validation of our reporting system — the output module that converts PAGER receptor activation into a measurable luminescence/colorimetric signal for influenza A virus detection.
      </p>
      {% set pdfUrl = "https://static.igem.wiki/teams/6373/wiki/lab/wetlab/notebook/notebook-reporter-module.pdf" %}
      {% set pdfLabel = "Notebook - Construction of the Reporting System" %}
      {% set pdfFallback = "This notebook PDF is not available yet." %}
      {% include "partials/pdf-embed.njk" %}
      <div class="notebook-resources">
        <a class="notebook-resources__protocol" href="protocol.html">Protocol: Reporter Module →</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
