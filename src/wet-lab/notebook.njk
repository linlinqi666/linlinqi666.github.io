  "04": "Restriction Enzyme Digestion",
  "05": "Agarose Gel Electrophoresis",
  "06": "Colony PCR for <i>E. coli</i>",
  "07": "Conventional PCR",
  "08": "Overlap Extension PCR",
  "09": "PCR Purification",
  "10": "Gel Extraction of PCR Products",
  "11": "Gibson Assembly",
  "12": "Yeast Transformation",
  "13": "Colony PCR for <i>Saccharomyces cerevisiae</i>",
  "14": "Yeast Growth Curve Measurement",
  "15": "Microscopic Observation of Yeast Morphology",
  "16": "Detection of Yeast Fluorescence Signal After Treatment",
  "17": "Confocal Imaging of Yeast Fluorescence After Treatment",
  "18": "SDS-PAGE and Western Blotting",
  "19": "CRISPR-Cas9 Transformation for Gene Knockout in Yeast",
  "20": "Functional Validation of the Yeast Sensor",
  "23": "Plasmid Extraction from Yeast",
