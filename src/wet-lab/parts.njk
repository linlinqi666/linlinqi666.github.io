---
permalink: "wet-lab/parts.html"
title: "Parts - iGEM SZPU-2026"
lang: "en"
headExtraPartial: "head-extra/wet-lab-parts.njk"
basePath: "../"
css:
  - static/css/parts.css
---

{% extends "layouts/base.njk" %}

{# 版式约定：英文在上为主视觉（.i18n-en），中文在下为辅助（.i18n-zh）。
   表格三列：元件 ID / 元件名称 / 元件描述。
   核验类信息不进入页面可见内容，只以 ⚠ 注释标注在源码中。 #}

{% macro pair(en, zh) %}<span class="i18n-en">{{ en | safe }}</span><span class="i18n-zh">{{ zh | safe }}</span>{% endmacro %}

{% block main %}
<section id="wet-lab-parts" class="parts-page">
      <header class="parts-hero">
        <h1>Parts</h1>
        <p class="parts-hero__sub">{{ pair(parts.overview.intro.en, parts.overview.intro.zh) }}</p>
        <div class="parts-hero__rule" aria-hidden="true"></div>
      </header>

      <div class="content-card parts-summary">
        <p class="parts-count">{{ pair(parts.overview.totalParts + ' parts across ' + parts.overview.groupCount + ' functional modules', parts.overview.totalParts + ' 个元件，分布于 ' + parts.overview.groupCount + ' 个功能模块') }}</p>
        <p class="parts-note">{{ pair(parts.overview.note.en, parts.overview.note.zh) }}</p>
      </div>

      {% for g in parts.groups %}
      <section class="content-card parts-group" id="{{ g.id }}">
        <h2>{{ pair(g.en, g.zh) }}</h2>
        <p class="parts-desc">{{ pair(g.desc.en, g.desc.zh) }}</p>
        <table class="parts-table">
          <thead>
            <tr>
              <th scope="col" class="col-id">{{ pair('Part ID', '元件 ID') }}</th>
              <th scope="col" class="col-name">{{ pair('Part name', '元件名称') }}</th>
              <th scope="col">{{ pair('Description', '元件描述') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for p in g.parts %}
            <tr>
              <td class="col-id">
                {% if p.id %}<a class="part-id" href="https://registry.igem.org/parts/{{ p.id | lower }}">{{ p.id }}</a>
                {% else %}{# ⚠ 核验：元件 ID 待分配（登记后填入编号并替换 href） #}<a class="part-id part-id--pending" href="#" aria-disabled="true">—</a>{% endif %}
              </td>
              <td class="col-name">{{ pair(p.en, p.zh) }}</td>
              <td class="col-fn">{{ pair(p.fn.en, p.fn.zh) }}
                {% if p.seq %}<details class="seq-block"><summary>{{ pair('Sequence', '序列') }}</summary><code class="seq">{{ p.seq }}</code></details>{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>
      {% endfor %}
    </section>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    // 移动端汉堡菜单切换
    const hamburgerMenu = document.getElementById('hamburger-menu');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenu = document.getElementById('mobile-menu');

    if (hamburgerMenu && mobileOverlay && mobileMenu) {
      hamburgerMenu.addEventListener('click', function (e) {
        e.stopPropagation();
        this.classList.toggle('active');
        mobileOverlay.classList.toggle('active');

        if (mobileOverlay.classList.contains('active')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });

      // 点击遮罩层关闭
      mobileOverlay.addEventListener('click', function (e) {
        if (e.target === mobileOverlay) {
          hamburgerMenu.classList.remove('active');
          mobileOverlay.classList.remove('active');
          document.body.style.overflow = '';

          document.querySelectorAll('.dropdown-open').forEach(function (item) {
            item.classList.remove('dropdown-open');
          });
        }
      });

      // 点击导航链接后关闭菜单
      const navLinks = mobileMenu.querySelectorAll('a:not(.dropdown-toggle)');
      navLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          hamburgerMenu.classList.remove('active');
          mobileOverlay.classList.remove('active');
          document.body.style.overflow = '';

          document.querySelectorAll('.dropdown-open').forEach(function (item) {
            item.classList.remove('dropdown-open');
          });
        });
      });
    }

    // 下拉菜单切换
    const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
    dropdownToggles.forEach(function (toggle) {
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const parentLi = this.closest('.dropdown');

        dropdownToggles.forEach(function (t) {
          const otherLi = t.closest('.dropdown');
          if (otherLi !== parentLi) {
            otherLi.classList.remove('dropdown-open');
          }
        });

        parentLi.classList.toggle('dropdown-open');
      });
    });

    // 点击页面其他地方关闭下拉菜单
    document.addEventListener('click', function () {
      document.querySelectorAll('.dropdown-open').forEach(function (item) {
        item.classList.remove('dropdown-open');
      });
    });
  
  });
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    new PageProgressBar().startAutoProgress();
  
  });
</script>
{% endblock %}
