        <img class="eng-fig__img" src="{{ basePath | default('') }}static/image/engineering/chassis/eng-chassis-fig03.png" alt="Figure 3. Sanger sequencing verification of FAR1 knockout." loading="lazy" width="1269" height="231" decoding="async">
