      </figure>
      <figure class="eng-fig">
        <img class="eng-fig__img" src="{{ basePath | default('') }}static/image/lab/wetlab/eg/chassis/eng-chassis-fig02-fix.png" alt="Figure 2. Colony PCR screening of transformants obtained by co-transformation of the linearized vector, linearized insert, and repair templates." loading="lazy" width="1177" height="586" decoding="async">
