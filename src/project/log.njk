---
permalink: "project/log.html"
title: "Log - iGEM SZPU-2026"
lang: "zh-CN"
basePath: "../"
css:
  - static/css/log.css
js:
  - static/js/pages/log-pdf-data.js
  - static/js/pages/log-pdf.js
---

{% extends "layouts/base.njk" %}

{% block main %}
<div class="description-container">
  <!-- 左侧文档导航（与其它内容页统一形态） -->
  <aside class="description-sidebar">
    <div class="yeast-decoration">
      <div class="yeast-cell yeast-cell-1"></div>
      <div class="yeast-cell yeast-cell-2"></div>
      <div class="yeast-cell yeast-cell-3"></div>
      <div class="bubble bubble-1"></div>
      <div class="bubble bubble-2"></div>
      <div class="bubble bubble-3"></div>
    </div>

    <div class="description-nav-wrapper">
      <ul class="description-nav">
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#wet-lab" class="nav-main-link">Wet Lab</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#dry-lab" class="nav-main-link">Dry Lab</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#human-practices" class="nav-main-link">Human Practices</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#wiki" class="nav-main-link">Wiki</a>
          </div>
        </li>
        <li class="level1">
          <div class="nav-link-wrapper">
            <a href="#team-management" class="nav-main-link">Team Management</a>
          </div>
        </li>
      </ul>
    </div>
  </aside>

  <div class="description-content">
    <div class="pdf-viewer" id="pdf-viewer" data-pdfjs-base="https://static.igem.org/2026/szpu-china/pdfjs/" data-pdfjs-local="../static/js/pdfjs/">
      <div class="pdf-viewer__header">
        <h1 class="pdf-doc-title" id="pdf-doc-title">实验记录</h1>
        <span class="pdf-doc-hint">PDF 文档在线阅读</span>
      </div>

      <div class="pdf-toolbar">
        <div class="pdf-toolbar__group">
          <button type="button" class="pdf-btn is-icon" data-action="prev" aria-label="上一页" disabled>‹</button>
          <input type="number" class="pdf-page-input" id="pdf-page-input" value="1" min="1" aria-label="页码" disabled>
          <span class="pdf-page-total" id="pdf-page-total">/ 1</span>
          <button type="button" class="pdf-btn is-icon" data-action="next" aria-label="下一页" disabled>›</button>
        </div>

        <div class="pdf-toolbar__group">
          <button type="button" class="pdf-btn is-icon" data-action="zoom-out" aria-label="缩小" disabled>−</button>
          <button type="button" class="pdf-btn is-icon" data-action="zoom-in" aria-label="放大" disabled>+</button>
          <button type="button" class="pdf-btn" data-action="fit" disabled>适应宽度</button>
        </div>

        <div class="pdf-toolbar__spacer"></div>

        <div class="pdf-toolbar__group pdf-toolbar__group--search">
          <div class="pdf-search">
            <input type="search" class="pdf-search__input" id="pdf-search-input" placeholder="搜索关键词" aria-label="在文档中搜索" disabled>
            <button type="button" class="pdf-btn is-icon" data-action="search-prev" aria-label="上一处" disabled>↑</button>
            <button type="button" class="pdf-btn is-icon" data-action="search-next" aria-label="下一处" disabled>↓</button>
          </div>
        </div>

        <div class="pdf-toolbar__group">
          <button type="button" class="pdf-btn" data-action="download" disabled>下载</button>
        </div>
      </div>

      <div class="pdf-stage" id="pdf-stage">
        <noscript>
          <div class="pdf-noscript">
            当前浏览器已禁用 JavaScript，无法在页面内预览文档。请点击上方「下载」获取 PDF 后使用本地阅读器查看。
          </div>
        </noscript>
      </div>

      <div class="pdf-status" id="pdf-status"></div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.LogPdfViewer) {
      window.LogPdfViewer.init({ root: '#pdf-viewer' });
    }
  });
</script>
{% endblock %}
