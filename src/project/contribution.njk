---
permalink: "project/contribution.html"
title: "Contribution - iGEM SZPU-2026"
lang: "zh-CN"
basePath: "../"
css:
  - static/css/contribution.css
js:
  - static/js/components/sidebar-progress.js
---

{% extends "layouts/base.njk" %}

{# 页面内容全部来自 src/_data/contribution.js（中英双语源），此处只负责渲染结构。 #}

{% block main %}
<div class="description-container">

      <!-- 左侧导航栏 -->
      <aside class="description-sidebar">
        <div class="yeast-decoration">
          <div class="yeast-cell yeast-cell-1"></div>
          <div class="yeast-cell yeast-cell-2"></div>
          <div class="yeast-cell yeast-cell-3"></div>
          <div class="bubble bubble-1"></div>
          <div class="bubble bubble-2"></div>
          <div class="bubble bubble-3"></div>
        </div>

        <div class="description-nav-wrapper">
          <ul class="description-nav">
            {% for item in contribution.nav %}
            <li class="level1">
              <div class="nav-link-wrapper">
                <a href="#{{ item.id }}" class="nav-main-link">{{ item.zh }}<span class="i18n-en">{{ item.en }}</span></a>
              </div>
              {% if item.children %}
              <ul class="level2">
                {% for child in item.children %}
                <li class="level3"><a href="#{{ child.id }}">{{ child.zh }}<span class="i18n-en">{{ child.en }}</span></a></li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </div>

        <!-- 发酵进度容器 -->
        <div class="progress-section">
          <div class="progress-flask">
            <div class="flask-body">
              <div class="flask-neck"></div>
              <div class="flask-liquid">
                <div class="liquid-fill"></div>
                <div class="bubbling">
                  <div class="ferment-bubble f-bubble-1"></div>
                  <div class="ferment-bubble f-bubble-2"></div>
                  <div class="ferment-bubble f-bubble-3"></div>
                  <div class="ferment-bubble f-bubble-4"></div>
                </div>
              </div>
            </div>
            <div class="flask-progress">
              <span class="progress-percentage" id="progress-percentage">0%</span>
            </div>
          </div>
          <div class="progress-title">发酵进度</div>
        </div>
      </aside>

      <!-- 右侧内容区域 -->
      <div class="description-content">
        {% for card in contribution.cards %}
        <div id="{{ card.id }}" class="content-card">
          <h2>{{ card.title.zh | safe }}<span class="i18n-en">{{ card.title.en | safe }}</span></h2>
          <div class="content-text-frame">
            {% if card.summary %}
            <p class="executive-summary">{{ card.summary.zh | safe }}<span class="i18n-en">{{ card.summary.en | safe }}</span></p>
            {% endif %}

            {% for block in card.blocks %}
              {% if block.type == 'p' %}
            <p{% if block.cls %} class="{{ block.cls }}"{% endif %}>{{ block.text.zh | safe }}<span class="i18n-en">{{ block.text.en | safe }}</span></p>

              {% elif block.type == 'ul' %}
            <ul>
              {% for it in block.items %}
              <li>{% if it.label %}<strong>{{ it.label.zh }}<span class="i18n-en">{{ it.label.en }}</span></strong>{% endif %}{{ it.text.zh | safe }}<span class="i18n-en">{{ it.text.en | safe }}</span></li>
              {% endfor %}
            </ul>

              {% elif block.type == 'fields' %}
            <ul>
              {% for f in block.items %}
              <li><strong>{{ f.label.zh }}<span class="i18n-en">{{ f.label.en }}</span></strong>{{ f.value.zh | safe }}<span class="i18n-en">{{ f.value.en | safe }}</span></li>
              {% endfor %}
            </ul>

              {% elif block.type == 'links' %}
            <ul>
              {% for a in block.items %}
              <li><a href="{{ a.href }}">{{ a.zh }}<span class="i18n-en">{{ a.en }}</span></a></li>
              {% endfor %}
            </ul>

              {% elif block.type == 'table' %}
            <h3>{{ block.heading.zh }}<span class="i18n-en">{{ block.heading.en }}</span></h3>
            <table style="width:100%; border-collapse:collapse; margin:1rem 0;">
              <thead>
                <tr style="border-bottom:2px solid #333;">
                  {% for h in block.head %}
                  <th style="border:1px solid #ccc; padding:8px; text-align:left;">{{ h.zh }}<span class="i18n-en">{{ h.en }}</span></th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in block.rows %}
                <tr style="border-bottom:1px solid #ddd;">
                  {% for cell in row %}
                  <td style="border:1px solid #ccc; padding:8px;">{{ cell.zh | safe }}{% if cell.en %}<span class="i18n-en">{{ cell.en | safe }}</span>{% endif %}</td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {

    new PageProgressBar().startAutoProgress();

  });
</script>
{% endblock %}
