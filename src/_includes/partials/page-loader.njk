    <!-- 全站页级加载遮罩：默认 display:none，仅当 head 内同步脚本
         page-loader-arm.js 给 <html> 打上 .page-loader-armed 后显示；
         由 static/js/components/page-loader.js 在首屏关键插画就绪后收尾。 -->
    <div class="page-loader" id="page-loader" role="status" aria-label="页面加载中">
      <div class="page-loader__inner">
        <div class="page-loader__stage">
          <span class="page-loader__halo" aria-hidden="true"></span>
          <div class="page-loader__frames" aria-hidden="true">
            <!-- 2026-10-04：原 6 帧雪碧图换成 2 帧插画（loader-frame-1/2.jpg，硬切逐帧）
                 2026-10-05：删去原「两帧图加载失败时兜底的呼吸三点」——两帧循环即默认 -->
            <span class="page-loader__frame page-loader__frame--1"></span>
            <span class="page-loader__frame page-loader__frame--2"></span>
          </div>
        </div>
        <p class="page-loader__text" aria-hidden="true">Loading</p>
      </div>
    </div>
