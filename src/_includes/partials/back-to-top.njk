<!-- 全站「返回顶部」悬浮按钮（2026-10-04）
     两张图叠合（透明底 webp，存于同级 transparent/）：
       外圈 back-to-top-ring（自带环绕文字，持续顺时针旋转）
       内芯 back-to-top-core（静止）
     hover：外圈与内芯作为整体一起上下浮动。
     由 base.njk 引入 → 每个页面都有一份；行为见 static/js/components/back-to-top.js。 -->
<button class="back-to-top" id="back-to-top" type="button" aria-label="返回顶部">
  <span class="back-to-top__ring" aria-hidden="true">
    <!-- 2026-10-05：外圈换用美工新图 back-to-top-ring.png（原带环绕文字 webp 已删） -->
    <img class="back-to-top__ring-img" src="{{ basePath | default('') }}static/image/Animation/top/transparent/back-to-top-ring.png"
      alt="" width="320" height="320" decoding="async">
  </span>
  <span class="back-to-top__core" aria-hidden="true">
    <img class="back-to-top__core-img" src="{{ basePath | default('') }}static/image/Animation/top/transparent/back-to-top-core.webp"
      alt="" width="320" height="320" decoding="async">
  </span>
</button>
