<!-- 全站公用 footer（2026-10-20 第二版）
     上排：左半＝五个圆形母气泡（3+2）+ 分裂子气泡；右半＝三个支持方 logo。
     气泡为「一张网」：一个展开会把自己的子气泡甩出来，同时反推自己、推挤其余四个；
     子气泡方向每次随机（footer-bubbles.js），没有固定角度。
     下排：版权两行居中，右侧三个社交图标（让开固定返回顶部按钮 50px）。 -->
<section id="footer" class="section-footer">
  <div class="component-container">
    <div class="footer-wrapper">
      <div class="footer-main">
        <div class="footer-bubbles" id="footer-bubbles" aria-label="Site map">
          <div class="bubble-stage" id="bubble-stage">

            <div class="bubble-group">
              <button type="button" class="bubble bubble--parent" aria-expanded="false"
                aria-controls="footer-bubble-project">Project</button>
              <div class="bubble-children" id="footer-bubble-project">
                <a class="bubble bubble--child" style="--i:0"
                  href="{{ basePath | default('') }}project/description.html">Description</a>
                <a class="bubble bubble--child" style="--i:1"
                  href="{{ basePath | default('') }}project/design.html">Design</a>
                <a class="bubble bubble--child" style="--i:2"
                  href="{{ basePath | default('') }}project/engineering.html">Engineering</a>
                <a class="bubble bubble--child" style="--i:3"
                  href="{{ basePath | default('') }}project/contribution.html">Contribution</a>
              </div>
            </div>

            <div class="bubble-group">
              <button type="button" class="bubble bubble--parent" aria-expanded="false"
                aria-controls="footer-bubble-team">Team</button>
              <div class="bubble-children" id="footer-bubble-team">
                <a class="bubble bubble--child" style="--i:0"
                  href="{{ basePath | default('') }}team/members.html">Members</a>
                <a class="bubble bubble--child" style="--i:1"
                  href="{{ basePath | default('') }}team/attributions.html">Attributions</a>
              </div>
            </div>

            <div class="bubble-group">
              <button type="button" class="bubble bubble--parent" aria-expanded="false"
                aria-controls="footer-bubble-wetlab">Wet Lab</button>
              <div class="bubble-children" id="footer-bubble-wetlab">
                <a class="bubble bubble--child" style="--i:0"
                  href="{{ basePath | default('') }}wet-lab/protocol.html">Protocol</a>
                <a class="bubble bubble--child" style="--i:1"
                  href="{{ basePath | default('') }}wet-lab/result.html">Results</a>
                <a class="bubble bubble--child" style="--i:2"
                  href="{{ basePath | default('') }}wet-lab/parts.html">Parts</a>
                <a class="bubble bubble--child" style="--i:3"
                  href="{{ basePath | default('') }}wet-lab/safety.html">Safety</a>
                <a class="bubble bubble--child" style="--i:4"
                  href="{{ basePath | default('') }}wet-lab/notebook.html">Notebook</a>
              </div>
            </div>

            <div class="bubble-group">
              <button type="button" class="bubble bubble--parent" aria-expanded="false"
                aria-controls="footer-bubble-drylab">Dry Lab</button>
              <div class="bubble-children" id="footer-bubble-drylab">
                <a class="bubble bubble--child" style="--i:0"
                  href="{{ basePath | default('') }}dry-lab/model.html">Model</a>
                <a class="bubble bubble--child" style="--i:1"
                  href="{{ basePath | default('') }}dry-lab/hardware.html">Hardware</a>
              </div>
            </div>

            <div class="bubble-group">
              <button type="button" class="bubble bubble--parent" aria-expanded="false"
                aria-controls="footer-bubble-hp">Human Practices</button>
              <div class="bubble-children" id="footer-bubble-hp">
                <a class="bubble bubble--child" style="--i:0"
                  href="{{ basePath | default('') }}human-practices/integrated human-practices.html">Integrated HP</a>
                <a class="bubble bubble--child" style="--i:1"
                  href="{{ basePath | default('') }}human-practices/sustainability.html">Sustainability</a>
              </div>
            </div>

          </div>
        </div>

        <div class="footer-partners" aria-label="Supported by">
          <a href="https://www.igem.org/" target="_blank" rel="noopener noreferrer" class="partner-chip">
            <img loading="lazy" decoding="async" src="https://static.igem.wiki/teams/6373/wiki/icon/igem.avif"
