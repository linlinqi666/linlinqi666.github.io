<section id="footer" class="section-footer{% if footerBg %} fullscreen-section{% endif %}">
  {% if footerBg %}<picture class="footer-bg-picture">
    <source srcset="{{ basePath | default('') }}static/image/bc/画板+7.webp" type="image/webp">
