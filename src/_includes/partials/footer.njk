        </div>

        <div class="footer-social">
          <div class="contact-icon-wrapper" data-tooltip="szpu@igem.org">
            <span class="iconfont icon-youxiang"></span>
          </div>
          <a href="https://space.bilibili.com/3706970825558875" target="_blank" rel="noopener noreferrer"
            class="contact-icon-wrapper" data-tooltip="Bilibili: SZPU-2026">
            <span class="iconfont icon-bilibili-fill"></span>
          </a>
          <a class="contact-icon-wrapper wechat-qr-wrapper" data-tooltip="WeChat: SZPU-2026">
