              <div class="wechat-qr-arrow"></div>
              <img loading="lazy" decoding="async" src="{{ basePath | default('') }}static/image/any-icon/other/echoyeast_social.jpg"
                alt="WeChat QR Code" class="wechat-qr-image" width="430" height="430">
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="{{ basePath | default('') }}static/js/components/footer-bubbles.js?v={{ assetV }}" defer></script>
