                <img loading="lazy" decoding="async" src="{{ basePath | default('') }}static/image/any-icon/SZPU(notext).webp" alt="SZPU" class="scroll-image">
              </a>
              <a href="https://fd.szpu.edu.cn/" target="_blank" rel="noopener noreferrer">
                <img loading="lazy" decoding="async" src="{{ basePath | default('') }}static/image/any-icon/shiyao(notext).webp" alt="shiyao" class="scroll-image">
              </a>
            </div>
          </div>
