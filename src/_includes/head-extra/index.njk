<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="format-detection" content="telephone=no, email=no, address=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="mobile-web-app-capable" content="yes">
  
  
  <meta name="color-scheme" content="light">

  <!-- 安全区域CSS变量定义（不应用到html元素以免破坏全屏布局） -->
  <style>
    :root {
      --sat: env(safe-area-inset-top, 0px);
      --sar: env(safe-area-inset-right, 0px);
      --sab: env(safe-area-inset-bottom, 0px);
      --sal: env(safe-area-inset-left, 0px);
    }
  </style>

  <!-- DNS预取 -->
  <link rel="dns-prefetch" href="static/iconfont">
  <link rel="dns-prefetch" href="static/css">
  <link rel="dns-prefetch" href="static/image">

  <!-- 预连接关键资源 -->
  <link rel="preconnect" href="static/iconfont" crossorigin>
  <link rel="preconnect" href="static/css" crossorigin>

  <!-- iGEM Layout Strategy: 预加载首屏 Hero 背景与主视觉，缩短 LCP。 -->
  <link rel="preload" as="image" href="static/image/bc/%E7%94%BB%E6%9D%BF+1.webp" fetchpriority="high">
  <link rel="preload" as="image" href="static/image/Animation/index/yeast1.svg" fetchpriority="high">
  

  <!-- 直接同步加载CSS，确保加载顺序可控 -->
  <!-- 加载顺序：基础样式 → 导航样式 → 全局样式 → 移动端样式（最后加载，确保覆盖） -->
  
  
  
  
  
  

  <!-- JavaScript 禁用回退：确保核心内容在无 JS 时仍可见 -->
  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }

      .typewriter::after {
        content: none !important;
      }
    </style>
  </noscript>
