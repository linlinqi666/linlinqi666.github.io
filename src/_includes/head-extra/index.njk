  <!-- 首页 GIF 开场动画组件样式：在 mobile.css 之后加载，保证响应式覆盖生效 -->
  <link rel="stylesheet" href="static/css/components/index-intro-gif.css">

  <!-- 2026-10-16：开场动画最高优先级预载。
       原实现要等 DOMContentLoaded 后才由 index-intro-gif.js 用 new Image() 发起请求，
       此时文档内约 40 张 eager 插画已被解析并占用连接，GIF（1.26MB 动画 webp）被排到
       后面，弱网下常出现「加载一下下就能浏览、开场被挤掉、各屏动画已放完」。
       preload + fetchpriority=high 让它在 head 解析期就以最高优先级起跑，
       并与 page-loader-arm.js 同步预载的加载帧并行。 -->
  <link rel="preload" as="image" href="static/image/Animation/index/gif/boot-animation.webp"
    fetchpriority="high">

  <!-- 首页 GIF 开场动画：在 <body> 渲染前同步给 <html> 打标记，
       避免导航栏在 GIF 播放期间先闪现再隐藏。
       触发条件：仅当访客从「站外 / 直接访问」进入首页时播放。
       站内跳转（如页脚、导航点回首页）referrer 与本站同源，不重复播放；
       无 JS 或 prefers-reduced-motion 时不打标记，导航栏按原逻辑直接显示；
       6s 看门狗兜底：若组件脚本未启动（加载失败/被拦截），强制恢复导航与滚动。 -->
  <script>
    (function () {
      try {
        var root = document.documentElement;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // 仅从站外（或空 referrer 的直接访问）进入时才播放开场动画；
        // 站内跳转（referrer 与本站同源）不重复触发，导航栏与滚动保持原样。
        var isExternal = true;
        var ref = document.referrer;
        if (ref) {
          try {
            isExternal = new URL(ref).origin !== location.origin;
          } catch (e) {
            isExternal = true;
          }
        }
        if (!isExternal) return;

        root.classList.add('intro-gif-armed');

        // 看门狗：组件脚本始终未启动时强制结束开场（恢复导航与滚动）。
        // 页面加载遮罩（page-loader）先播、GIF 后播：遮罩期间不计时，
        // 等 pageloader:done 或硬上限后再开始 6s 计时，避免把 GIF 卡没。
        // 2026-10-06 弱网修复：组件已启动但 GIF 仍在下载时（组件挂出
        // window.__introGifWaiting），看门狗不再强判 finished——组件自身有
        // 20s 单帧下载超时兜底（超时会自行 finish），此处再加 30s 二级
        // 硬兜底，绝不让导航被永久锁住。原实现 6s 一到就把还在等 GIF
        // 的开场层直接判死，弱网下 GIF 必被「挤掉」。
        // 2026-10-16：再加一道 defer 脚本守卫——页面级脚本（含三个入场动画
        // 脚本）还没执行完时绝不强判开场结束，重排 500ms 后复查（硬上限 60s）。
        // 原实现在脚本仍在下载/排队时就解锁，用户翻页看到的就是
        // 「静态年值 / 无动画的三方法」。注意不能只看 readyState：文档
        // 「解析完成」会把 readyState 推到 interactive，但 defer 脚本可能
        // 还在网络队列里（弱网实测排队 44s），以三个 armed 类为准。
        var DEFER_GUARD_MAX = 60000;
        var deferGuardStart = Date.now();
        function pageScriptsRan() {
          return !!(document.querySelector('.js-reveal-armed, .js-burden-armed, .js-pager-story'));
        }
        function deferScriptsPending() {
          if (pageScriptsRan()) return false;
          return (Date.now() - deferGuardStart) < DEFER_GUARD_MAX;
        }
        var watchdogStarted = false;
        function startWatchdogOnce() {
          if (watchdogStarted) return;
          watchdogStarted = true;
          var tick = function () {
            if (deferScriptsPending()) {
              setTimeout(tick, 500);
              return;
            }
            if (window.__introGifWaiting) {
              // 组件在等 GIF：交给组件自己的超时收尾，另设二级硬兜底
              setTimeout(function () {
                if (!root.classList.contains('intro-gif-running')) {
                  root.classList.add('intro-gif-finished');
                }
              }, 30000);
              return;
            }
            if (!root.classList.contains('intro-gif-running')) {
              root.classList.add('intro-gif-finished');
            }
          };
          setTimeout(tick, 6000);
        }
        if (root.classList.contains('page-loader-armed')) {
          document.addEventListener('pageloader:done', startWatchdogOnce);
          setTimeout(startWatchdogOnce, 12000);
        } else {
          startWatchdogOnce();
        }
      } catch (e) { /* 降级：保持导航栏可见 */ }
    })();
  </script>

  <!-- 2026-10-17：future-vision 五块入场动画「只播一次」（用户要求：
       不是每次进页面都重新触发）。
       规则：首播时在 body 渲染前给 <html> 打 fv-reveal-arm（CSS 据此才隐藏五块），
       区块首次进入视口即记入 localStorage；此后进页面不再打标记，五块直接是终态，
       不再等 8 秒。已播过 / prefers-reduced-motion / 无 IntersectionObserver /
       无 JS 时都不打标记——内容默认可见，不会出现空白或永久隐藏。 -->
  <script>
    (function () {
      var KEY = 'fv-reveal-played-v1';
      try {
        var root = document.documentElement;
        var played = false;
        try { played = window.localStorage.getItem(KEY) === '1'; } catch (e) { played = false; }
        if (played) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        root.classList.add('fv-reveal-arm');

        document.addEventListener('DOMContentLoaded', function () {
          var sec = document.getElementById('future-vision');
          if (!sec) {
            root.classList.remove('fv-reveal-arm');
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (!entries[i].isIntersecting) continue;
              io.disconnect();
              // 直接给五块挂 reveal--visible：动画不依赖全站共享 .reveal 观察器的阈值，
              // 首访即便它未触发也不会把内容永久隐藏。
              var blocks = sec.querySelectorAll('.fv-quadrants .reveal');
              for (var j = 0; j < blocks.length; j++) blocks[j].classList.add('reveal--visible');
              try { window.localStorage.setItem(KEY, '1'); } catch (e) { /* 隐私模式忽略 */ }
              return;
            }
          }, { threshold: 0.2 });
          io.observe(sec);
        });
      } catch (e) { /* 降级：保持可见 */ }
    })();
  </script>

  <!-- 安全区域CSS变量定义（不应用到html元素以免破坏全屏布局） -->
  <style>
    :root {
      --sat: env(safe-area-inset-top, 0px);
      --sar: env(safe-area-inset-right, 0px);
      --sab: env(safe-area-inset-bottom, 0px);
      --sal: env(safe-area-inset-left, 0px);
    }
  </style>

