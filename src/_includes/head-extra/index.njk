  <!-- JavaScript 禁用回退：确保核心内容在无 JS 时仍可见 -->
  <noscript>
    <style>
      .reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }

      .typewriter::after {
        content: none !important;
      }
    </style>
  </noscript>
