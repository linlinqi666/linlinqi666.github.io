  .hp-flat-card::after { content: ""; position: absolute; inset: 0; border: 2px solid rgba(166,124,82,.9); opacity: 0; pointer-events: none; }
  /* 到位特效：切换到某板块时，对应卡片金环闪现 + 轻微回弹，提示“已滚动到该位置” */
