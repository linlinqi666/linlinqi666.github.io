  }
  .hz-map .hz-filter.collapsed {
    min-width: auto; padding: 8px;
  }
  .hz-map .hz-filter-header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px;
  }
  .hz-map .hz-filter.collapsed .hz-filter-header { justify-content: center; }
