  .hz-map .hz-filter .hz-dot.industry { background: #9013FE; }
  .hz-map .hz-filter .hz-dot.public { background: #F5A623; }
  @media (max-width: 640px) {
    .hz-map .hz-filter {
      position: relative; top: auto; right: auto;
      margin: 10px 0 0;
      border-radius: 10px;
      box-shadow: none;
      background: rgba(255,255,255,.9);
    }
  }

  /* 图钉：圆形头像 + 分类色边框，中心落在坐标点 */
  .hz-map .hz-pin {
