<style>

  /* 所有选择器都限定在 .hz-map 根容器内，迁移到其它页面不会与宿主样式冲突 */
  .hz-map * { box-sizing: border-box; margin: 0; padding: 0; }

  .hz-map {
    --hz-accent: #a67c52;
    --hz-filter-bg: rgba(255,255,255,.92);
    --hz-filter-text: #3d342b;
    --hz-filter-border: rgba(139,115,85,.25);
    --hz-map-bg-1: #e8dfd2;
    --hz-map-bg-2: #d6c9b6;
    --hz-province-fill: #c9b99a;
    --hz-province-stroke: #a8997d;
    --hz-province-hover: #b8a883;
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    color: #4a3f33;
    max-width: 1100px; margin: 0 auto;
    /* 暖棕色画框，与项目主题色保持一致 */
    background: radial-gradient(1200px 600px at 50% -10%, #f3eadd 0%, #e0d2c1 60%, #c9b99a 100%);
    padding: 24px 18px 36px;
    border-radius: 20px;
    box-shadow: 0 24px 70px rgba(74,59,42,.22);
    /* 隔离层叠与布局，避免影响宿主页面 */
    isolation: isolate;
  }

  .hz-map .hz-header {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 18px;
  }
  .hz-map .hz-header h1 {
    font-size: 22px; font-weight: 700; letter-spacing: 1px;
    color: #5c4d3c;
  }
  .hz-map .hz-header .hz-hint { font-size: 13px; color: #7d6d5a; }



  .hz-map .hz-container {
    position: relative; width: 100%;
    aspect-ratio: 774.044 / 569.651;        /* 中国地图 natural ratio */
    background: linear-gradient(180deg, var(--hz-map-bg-1) 0%, var(--hz-map-bg-2) 100%);
    border: 1px solid rgba(139,115,85,.25);
    border-radius: 18px;
    /* 用 padding 给边缘 pin 留出安全区，避免被圆角背景裁切 */
    padding: 18px; box-sizing: border-box;
    box-shadow: 0 20px 60px rgba(74,59,42,.18);
    contain: layout paint style;              /* 加强 containment */
  }

  .hz-map .hz-layer {
    position: absolute; inset: 18px;
    /* 性能优化：CSS contain 限制浏览器重排/重绘范围 */
    contain: layout style paint size;
    content-visibility: auto;
  }
  /* 中国地图层：默认始终可见 */
  .hz-map .hz-china { 
    opacity: 1; 
    transform: none; 
    pointer-events: auto;
    visibility: visible;
  }

  .hz-map .hz-layer > svg { 
    width: 100%; height: 100%; display: block;
    /* SVG 渲染优化：限制重绘范围 */
    contain: layout paint; 
  }

  .hz-map .hz-pins {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 5;
  }
  .hz-map .hz-pins .hz-pin { pointer-events: auto; }

  .hz-map #chinaProvinces path:focus,
  .hz-map #chinaProvinces path:focus-visible { outline: none; }

  /* 中国地图：省份路径 - 暖棕主题，悬停高亮 */
  .hz-map #chinaProvinces path {
    fill: var(--hz-province-fill); stroke: var(--hz-province-stroke); stroke-width: .8;
    contain: layout paint;
    pointer-events: auto;
    cursor: pointer;
    transition: fill .2s ease, stroke .2s ease;
  }
  .hz-map #chinaProvinces path:hover {
    fill: var(--hz-province-hover);
    stroke: var(--hz-province-stroke);
  }

  /* ===== 筛选面板 ===== */
  .hz-map .hz-filter {
    position: absolute; top: 14px; right: 14px; z-index: 20;
    background: var(--hz-filter-bg);
