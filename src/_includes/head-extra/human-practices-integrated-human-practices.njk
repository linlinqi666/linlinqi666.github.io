    }
  }

  /* 省份集合点：地图图钉造型（上圆头 + 下尖尾），针尖对准坐标；头内放专家照片或默认人像剪影 */
  .hz-map .hz-cluster {
    --pin-head: 32px;
    --pin-tail: 14px;
    position: absolute; width: var(--pin-head);
    height: calc(var(--pin-head) + var(--pin-tail) - 2px);
    padding: 0;
    transform: translate(-50%, -100%); transform-origin: 50% 100%;
    z-index: 25; cursor: pointer;
    appearance: none; border: none;
    background: transparent; color: transparent;
    filter: drop-shadow(0 3px 4px rgba(74,59,42,.35));
    transition: transform .18s cubic-bezier(.4,0,.2,1), filter .18s ease;
    contain: none !important;
    overflow: visible;
  }
  /* 针尾：等腰三角，随分类色 */
  .hz-map .hz-cluster::before {
    content: ""; position: absolute; left: 50%; top: calc(var(--pin-head) - 7px);
    width: calc(var(--pin-head) * .46); height: calc(var(--pin-tail) + 8px);
    transform: translateX(-50%);
    background: var(--cluster-color, #8B7355);
    clip-path: polygon(50% 100%, 4% 0, 96% 0);
  }
  /* 针头：圆形头像位 */
  .hz-map .hz-cluster__head {
    position: absolute; top: 0; left: 0;
    width: var(--pin-head); height: var(--pin-head);
    border-radius: 50%; box-sizing: border-box;
    background: #f3ead8; border: 2px solid var(--cluster-color, #8B7355);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .hz-map .hz-cluster__head--count {
    background: var(--cluster-color, #8B7355); border-color: #fff8e7;
    color: #fff; font-size: 13px; font-weight: 700; line-height: 1;
  }
  /* 多专家针头的人数角标 */
  .hz-map .hz-cluster__badge {
    position: absolute; right: -3px; top: calc(var(--pin-head) - 8px);
    min-width: 15px; height: 15px; padding: 0 3px; box-sizing: border-box;
    border-radius: 50%; border: 1.5px solid #fff8e7;
    background: var(--cluster-color, #8B7355); color: #fff;
    font-size: 10px; font-weight: 700; line-height: 12px; text-align: center;
  }
  .hz-map .hz-cluster__photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hz-map .hz-cluster__silhouette { width: 74%; height: 74%; fill: #a89177; }
  .hz-map .hz-cluster__count,
  .hz-map .hz-cluster__name { display: none; }
  .hz-map .hz-cluster:hover,
  .hz-map .hz-cluster:focus-visible,
  .hz-map .hz-cluster.is-active {
    transform: translate(-50%, -100%) scale(1.14); z-index: 30; outline: none;
    filter: drop-shadow(0 6px 9px rgba(74,59,42,.42));
  }
  .hz-map .hz-cluster-popover {
    position: absolute; left: 0; top: 0; z-index: 40; width: min(280px, calc(100% - 24px));
    padding: 14px; border: 1px solid rgba(139,115,85,.36); border-radius: 14px;
    background: rgba(255,250,240,.98); color: #4a3f33; box-shadow: 0 14px 34px rgba(74,59,42,.24);
  }
  .hz-cluster-popover[hidden] { display: none; }
  .hz-cluster-popover__header { display:flex; justify-content:space-between; gap: 10px; margin-bottom: 10px; font-size: 13px; }
  .hz-cluster-popover__header span { color:#8b7355; font-size:12px; }
  .hz-cluster-popover ul { display:flex; flex-direction:column; gap:6px; margin:0; padding:0; list-style:none; max-height:240px; overflow:auto; }
