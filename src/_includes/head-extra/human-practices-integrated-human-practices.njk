    /* 隔离层叠与布局，避免影响宿主页面 */
    isolation: isolate;
  }

  /* 页面只保留两个主容器：概述+地图，以及人物信息；信息区内部不再绘制套盒子。 */
  .hp-overview-map-card { margin-top: var(--desc-spacing-3xl); }
  .hz-details-card { margin-top: var(--desc-spacing-3xl); }
