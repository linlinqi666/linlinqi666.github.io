  .hz-cluster-expert[data-category="public"]:hover,
  .hz-cluster-expert[data-category="public"]:focus-visible { border-color:#F5A623; background:#fbeed6; outline:none; }
  .hz-cluster-expert__name, .hz-cluster-expert__meta { display:block; }
  .hz-cluster-expert__name { font-weight:700; font-size:13px; }
  .hz-cluster-expert__meta { margin-top:3px; color:#7d6d5a; font-size:11px; line-height:1.4; }
  @media (max-width: 640px) {
