  }
  .hp3d-root .hp-tsinghua-grid .hp-photo-item {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(74, 59, 42, 0.08);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .hp3d-root .hp-tsinghua-grid .hp-photo-item:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 10px 24px rgba(74, 59, 42, 0.16);
  }
  .hp3d-root .hp-tsinghua-grid .hp-photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .hp3d-root .hp-tsinghua-grid .hp-photo-item:hover img { transform: scale(1.05); }
  .hp3d-root .hp-tsinghua-grid .hp-photo-item figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 12px;
    background: linear-gradient(transparent, rgba(74, 55, 40, 0.75));
    color: white;
    font-size: 0.82rem;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hp3d-root .timeline-orbit-container { padding: 0 14px; }
    .hp3d-root .dual-stage { perspective: 760px; }
    .hp3d-root .slider-input::-webkit-slider-thumb { width: 24px; height: 24px; }
    .hp3d-root .detail-slide { padding: 18px 16px 20px; }
    .hp3d-root .detail-slide .detail-headtext h3 { font-size: 1.08rem; }
    .hp3d-root .detail-photos { grid-template-columns: repeat(2, 1fr); }
    .hp3d-root .hp-tsinghua-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(3, 150px); gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp3d-root .dual-scene, .hp3d-root .orbit-card, .hp3d-root .timeline-node,
    .hp3d-root .detail-panel, .hp3d-root .detail-track, .hp3d-root .slider-fill { transition: none !important; }
  }
  </style>
  
  
  
    
  
  
  
  
  
  
  
  
  
