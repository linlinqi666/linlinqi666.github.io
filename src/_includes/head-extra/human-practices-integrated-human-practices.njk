  .hz-detail-viewport { overflow: hidden; border-radius: 18px; }
  .hz-detail-track { display: flex; align-items: flex-start; transition: transform .5s cubic-bezier(.22,1,.36,1); will-change: transform; }
  .hz-detail-slide { flex: 0 0 100%; min-width: 100%; }
  .hz-detail-card { display: grid; grid-template-columns: minmax(160px, 220px) 1fr; gap: 1.5rem; align-items: start; padding: 1.5rem; border: 1px solid rgba(139,115,85,.2); border-radius: 18px; background: rgba(255,255,255,.78); box-shadow: 0 14px 36px rgba(74,59,42,.14); }
  .hz-detail-card:not(:has(.hz-detail-card__photo)) { grid-template-columns: 1fr; }
