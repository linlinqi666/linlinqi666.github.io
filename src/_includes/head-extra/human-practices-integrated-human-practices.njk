  .hz-detail-card__table { width: 100%; border-collapse: collapse; margin: 0 0 1rem; font-size: .92rem; background: rgba(255,255,255,.6); border: 1px solid rgba(139,115,85,.28); border-radius: 12px; overflow: hidden; }
  .hz-detail-card__table th, .hz-detail-card__table td { padding: .6rem .8rem; border-bottom: 1px solid rgba(139,115,85,.18); text-align: left; vertical-align: top; line-height: 1.55; }
  .hz-detail-card__table th { background: rgba(139,115,85,.14); color: #5c4d3c; font-weight: 700; }
  .hz-detail-card__table tr:last-child td { border-bottom: none; }
  .hz-map .hz-cluster.is-active { transform: translate(-50%, -50%) scale(1.1); z-index: 30; filter: drop-shadow(0 0 8px rgba(74,59,42,.45)); }
  .hz-detail-card:focus { outline: 3px solid rgba(139,115,85,.45); outline-offset: 3px; }
  @media (max-width: 680px) { .hz-details-intro, .hz-detail-card { padding: 1.15rem; } .hz-detail-card { grid-template-columns: 1fr; } .hz-detail-card__photo { max-width: 260px; } }
  @media (prefers-reduced-motion: reduce) { .hz-detail-track { transition: none; } }

  .hz-map .hz-header {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 18px;
  }
  .hz-map .hz-header h1 {
    font-size: 22px; font-weight: 700; letter-spacing: 1px;
    color: #5c4d3c;
  }
  .hz-map .hz-header .hz-hint { font-size: 13px; color: #7d6d5a; }



  .hz-map .hz-container {
    position: relative; width: 100%;
    aspect-ratio: 774.044 / 569.651;        /* 中国地图 natural ratio */
    background: linear-gradient(180deg, var(--hz-map-bg-1) 0%, var(--hz-map-bg-2) 100%);
    border: 1px solid rgba(139,115,85,.25);
    border-radius: 18px;
    /* 用 padding 给边缘 pin 留出安全区，避免被圆角背景裁切 */
    padding: 18px; box-sizing: border-box;
    box-shadow: 0 20px 60px rgba(74,59,42,.18);
    /* 覆盖 static CSS 中的 contain，避免创建额外 stacking context 导致图钉被地图层覆盖 */
    contain: none !important;
  }

  .hz-map .hz-layer {
    position: absolute; inset: 18px;
    z-index: 1;
    /* 覆盖 static CSS 中的 contain/content-visibility */
    contain: none !important;
    content-visibility: visible !important;
  }
  /* 中国地图层：默认始终可见 */
  .hz-map .hz-china { 
    opacity: 1; 
    transform: none; 
    pointer-events: auto;
    visibility: visible;
  }

  .hz-map .hz-layer > svg { 
    width: 100%; height: 100%; display: block;
    contain: none !important;
  }

  .hz-map .hz-pins {
    position: absolute; top: 18px; left: 18px; right: 18px; bottom: 18px;
    pointer-events: none;
    z-index: 5;
  }
  .hz-map .hz-pins .hz-cluster,
  .hz-map .hz-pins .hz-cluster-popover { pointer-events: auto; }

  .hz-map #chinaProvinces path:focus,
  .hz-map #chinaProvinces path:focus-visible { outline: none; }

  /* 中国地图：省份路径 - 暖棕主题，悬停高亮 */
  .hz-map #chinaProvinces path {
    fill: var(--hz-province-fill); stroke: var(--hz-province-stroke); stroke-width: .8;
    pointer-events: auto;
    cursor: pointer;
    transition: fill .2s ease, stroke .2s ease;
    contain: none !important;
  }
  .hz-map #chinaProvinces path:hover {
    fill: var(--hz-province-hover);
    stroke: var(--hz-province-stroke);
  }

  /* ===== 筛选面板 ===== */
  .hz-map .hz-filter {
    position: absolute; top: 14px; left: 14px; z-index: 20;
    background: var(--hz-filter-bg);
    color: var(--hz-filter-text);
    border: 1px solid var(--hz-filter-border);
    border-radius: 12px;
    padding: 10px 12px;
    box-shadow: 0 6px 20px rgba(74,59,42,.15);
    font-size: 13px;
    backdrop-filter: blur(4px);
