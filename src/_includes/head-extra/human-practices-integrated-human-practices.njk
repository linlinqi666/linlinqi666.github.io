  /* 省份集合点：形状调试阶段——先不放任何内容，仅展示小尺寸图钉形状以便调整大小 */
  .hz-map .hz-cluster {
    position: absolute; width: 18px; min-height: 18px; padding: 0;
    transform: translate(-50%, -50%); z-index: 25; cursor: pointer;
    appearance: none; border: none;
