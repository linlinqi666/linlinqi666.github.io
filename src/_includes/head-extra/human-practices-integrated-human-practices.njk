  }
  .hz-map .hz-filter.collapsed .hz-filter-title { display: none; }
  .hz-map .hz-filter-toggle {
    width: 24px; height: 24px; border: none; border-radius: 6px;
    background: transparent; color: #5c4d3c; cursor: pointer;
