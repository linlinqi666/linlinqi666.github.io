  .hp-flat-card:hover span, .hp-flat-card:focus-visible span { transform: translateY(-2px); opacity: 1; }
  @keyframes hpCardIn { from { opacity: 0; transform: translateY(12px); } to { opacity: .72; transform: none; } }
