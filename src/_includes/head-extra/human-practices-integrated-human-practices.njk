<!-- 3D 时间轴样式：照搬自 对话归档/tests/demo-3d-timeline.html，
       作用域限定在 .hp3d-root，不污染站点全局样式 -->
  <style>
  .hp3d-root, .hp3d-root *, .hp3d-root *::before, .hp3d-root *::after { box-sizing: border-box; }
  .hp3d-root {
    --color-primary: #4a3b2a;
    --color-cream: #f6f1e7;
    --color-bg: #faf8f3;
    --color-accent: #8b7355;
  }
  .hp3d-root .timeline-orbit-container { max-width: 1200px; margin: 5rem auto 2rem; padding: 0 24px; overflow: visible; }
  .hp3d-root .container-header { text-align: center; margin-bottom: 0.6rem; }
  .hp3d-root .container-header h1 { font-size: 1.7rem; font-weight: 600; }
  .hp3d-root .container-header .subtitle { font-size: 0.9rem; color: var(--color-accent); opacity: 0.75; }

  /* 单一共享 3D 舞台：卡片环与日期环同处一个透视空间，靠固定几何定位，
     不再有跨舞台运行时测量，整条时间环也绝不会因调参而整体平移 */
  .hp3d-root .dual-stage { position: relative; width: 100%; perspective: 1100px; perspective-origin: 50% 55%; overflow: visible; }
  .hp3d-root .dual-scene { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; opacity: 0; }
  .hp3d-root .cards-group { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .hp3d-root .orbit-ring { position: absolute; left: 50%; top: 50%; width: calc(2 * var(--r, 280px)); height: calc(2 * var(--r, 280px)); margin-left: calc(-1 * var(--r, 280px)); margin-top: calc(-1 * var(--r, 280px)); border-radius: 50%; border: 2px dashed rgba(74,59,42,0.22); transform: rotateX(90deg); pointer-events: none; }
  .hp3d-root .timeline-group { position: absolute; inset: 0; transform-style: preserve-3d; }
  .hp3d-root .timeline-ring { position: absolute; left: 50%; top: 50%; width: calc(2 * var(--tr, 300px)); height: calc(2 * var(--tr, 300px)); margin-left: calc(-1 * var(--tr, 300px)); margin-top: calc(-1 * var(--tr, 300px)); border-radius: 50%; border: 1.5px dashed rgba(139,115,85,0.25); transform: rotateX(90deg); pointer-events: none; }
  .hp3d-root .timeline-node { position: absolute; width: 80px; height: 20px; left: 47%; top: 48%; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; will-change: transform, opacity; transform-style: preserve-3d; }
  .hp3d-root .timeline-node-label { font-size: 0.75rem; white-space: nowrap; color: var(--color-accent); font-weight: 600; letter-spacing: 0.03em; opacity: 0.8; transition: all 0.3s ease; font-variant-numeric: tabular-nums; }
  .hp3d-root .timeline-node.active .timeline-node-label { color: var(--color-primary); }
  .hp3d-root .orbit-card { position: absolute; left: 50%; top: 50%; border-radius: 16px; cursor: pointer; background-color: #c9b89c; background-size: cover; background-position: center; border: 3px solid rgba(246,241,231,0.95); box-shadow: 0 16px 38px -12px rgba(74,59,42,0.45); transform-style: preserve-3d; will-change: transform, opacity; transition: box-shadow 0.4s ease; }
  .hp3d-root .orbit-card .orbit-card-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(74,59,42,0.4); font-size: 0.85rem; letter-spacing: 0.05em; border-radius: 16px; }
  .hp3d-root .orbit-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; border-radius: 16px; }
  /* 透明扩展热区：让转到两侧（被 3D 压缩、视觉较小的）卡片更容易点击跳转，
     不影响视觉尺寸，仅扩大可点击范围（inset 负值向外延伸） */
  .hp3d-root .orbit-card::after { content: ""; position: absolute; inset: -22px; border-radius: 20px; }
  .hp3d-root .orbit-card.front { box-shadow: 0 28px 52px -14px rgba(74,59,42,0.55), 0 0 0 1px rgba(74,59,42,0.15); }

  .hp3d-root .slider-control { position: relative; height: 56px; display: flex; align-items: center; justify-content: center; padding: 0 40px; margin-top: 2px; }
  .hp3d-root .slider-wrapper { position: relative; width: 100%; max-width: 760px; height: 40px; display: flex; align-items: center; }
  .hp3d-root .slider-track { position: absolute; width: 100%; height: 5px; background: linear-gradient(90deg, rgba(139,115,85,0.1), rgba(139,115,85,0.28), rgba(139,115,85,0.1)); border-radius: 3px; overflow: hidden; }
  .hp3d-root .slider-fill { position: absolute; left: 0; height: 100%; background: linear-gradient(90deg, var(--color-accent), var(--color-primary)); border-radius: 3px; width: 0%; }
  .hp3d-root .slider-input { position: relative; width: 100%; height: 40px; -webkit-appearance: none; appearance: none; background: transparent; cursor: grab; z-index: 2; margin: 0; }
  .hp3d-root .slider-input:active { cursor: grabbing; }
  .hp3d-root .slider-input::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--color-cream), #fff); border: 3px solid var(--color-primary); box-shadow: 0 4px 14px rgba(74,59,42,0.32), inset 0 1px 0 rgba(255,255,255,0.8); cursor: grab; transition: transform 0.16s ease; }
  .hp3d-root .slider-input::-webkit-slider-thumb:hover { transform: scale(1.12); }
  .hp3d-root .slider-input::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.03); }
  .hp3d-root .slider-input::-moz-range-thumb { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--color-cream), #fff); border: 3px solid var(--color-primary); box-shadow: 0 4px 14px rgba(74,59,42,0.32); cursor: grab; }

  .hp3d-root .detail-panel { margin-top: 8px; background: var(--color-cream); border-radius: 14px; border: 1px solid rgba(74,59,42,0.1); box-shadow: 0 10px 36px -14px rgba(74,59,42,0.26); overflow: hidden; opacity: 0; transform: translateY(30px); transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22,1,0.36,1); }
  .hp3d-root .detail-panel.show { opacity: 1; transform: translateY(0); }
  .hp3d-root .detail-viewport { overflow: hidden; }
  .hp3d-root .detail-track { display: flex; transition: transform 0.42s cubic-bezier(0.22,1,0.36,1); will-change: transform; }
  .hp3d-root .detail-slide { flex: 0 0 100%; padding: 26px 30px 30px; }

  .hp3d-root .detail-head { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 14px; }
  .hp3d-root .detail-num { flex-shrink: 0; font-size: 1.45rem; font-weight: 700; color: var(--color-accent); line-height: 1; padding-top: 2px; font-variant-numeric: tabular-nums; }
  .hp3d-root .detail-headtext h3 { font-size: 1.2rem; font-weight: 700; line-height: 1.4; }
  .hp3d-root .detail-sub { font-size: 0.82rem; color: var(--color-accent); opacity: 0.78; margin-top: 4px; }
  .hp3d-root .detail-intro { font-size: 0.92rem; line-height: 1.72; color: rgba(74,59,42,0.8); margin-bottom: 16px; }
  .hp3d-root .detail-expert { display: flex; gap: 16px; align-items: center; background: rgba(74,59,42,0.05); border-radius: 12px; padding: 14px 16px; margin-bottom: 16px; }
  .hp3d-root .detail-expert-avatar { width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, #cbb89a, #a8906f); display: flex; align-items: center; justify-content: center; color: rgba(246,241,231,0.9); font-size: 1.3rem; font-weight: 700; overflow: hidden; }
  .hp3d-root .detail-expert-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .hp3d-root .detail-expert-name { font-size: 1rem; font-weight: 700; }
  .hp3d-root .detail-expert-title { font-size: 0.8rem; color: var(--color-accent); margin: 2px 0 4px; }
  .hp3d-root .detail-expert-field { font-size: 0.8rem; line-height: 1.55; color: rgba(74,59,42,0.7); }
  .hp3d-root .detail-photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 18px; }
  .hp3d-root .detail-photo { position: relative; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background: linear-gradient(135deg, #ddd0b8, #c3b291); display: flex; align-items: flex-end; justify-content: center; }
  .hp3d-root .detail-photo img { width: 100%; height: 100%; object-fit: cover; }
  .hp3d-root .detail-photo span { position: absolute; bottom: 0; left: 0; right: 0; font-size: 0.68rem; color: rgba(74,59,42,0.55); background: rgba(246,241,231,0.7); padding: 2px 4px; text-align: center; }
  .hp3d-root .detail-insights { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .hp3d-root .detail-insight { background: rgba(74,59,42,0.04); border-left: 3px solid var(--color-accent); border-radius: 7px; padding: 11px 13px; }
  .hp3d-root .detail-insight h4 { font-size: 0.88rem; margin-bottom: 5px; display: flex; align-items: center; gap: 7px; }
  .hp3d-root .detail-insight h4::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
  .hp3d-root .detail-insight p { font-size: 0.8rem; line-height: 1.58; color: rgba(74,59,42,0.7); }
  .hp3d-root .detail-counter { text-align: center; font-size: 0.76rem; color: var(--color-accent); letter-spacing: 0.1em; padding: 8px 0 2px; opacity: 0.65; }

  /* 取消 reveal-box 后，内容块不再需要为把手预留底部空间 */
  .hp3d-root .detail-slide .hp-reveal-content { padding-bottom: var(--desc-spacing-2xl, 1.5rem); }

  /* 清华交流：用常规网格替代 3D 轮播 */
  .hp3d-root .hp-tsinghua-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 200px);
