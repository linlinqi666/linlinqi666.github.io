          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__dcz" data-dcz="left" data-no-reveal data-critical src="{{ basePath | default('') }}static/image/Animation/index/lab/DCZ.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__dcz" data-dcz="right" data-no-reveal data-critical src="{{ basePath | default('') }}static/image/Animation/index/lab/DCZ.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__ha pager__ha--bind" data-ha="bind" data-no-reveal data-critical src="{{ basePath | default('') }}static/image/Animation/index/lab/HA.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__ha" data-ha="1" data-no-reveal src="{{ basePath | default('') }}static/image/Animation/index/lab/HA.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__ha" data-ha="2" data-no-reveal src="{{ basePath | default('') }}static/image/Animation/index/lab/HA.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__ha" data-ha="3" data-no-reveal src="{{ basePath | default('') }}static/image/Animation/index/lab/HA.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
        <img loading="lazy" class="pager__layer pager__ha" data-ha="4" data-no-reveal src="{{ basePath | default('') }}static/image/Animation/index/lab/HA.png"
          alt="" aria-hidden="true" width="1600" height="1600" decoding="async">
