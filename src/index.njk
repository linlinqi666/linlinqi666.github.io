---
permalink: "index.html"
title: "iGEM SZPU-2026 - Home"
lang: "zh-CN"
htmlClass: "home-scroll-snap"
footer: false
headExtraPartial: "head-extra/index.njk"
bodyClass: "home-page"
mainClass: "long-page"
js:
  - static/js/components/executive-summary-animation.js
  - static/js/components/index-intro-gif.js
  - static/js/components/mascot-portal.js
  - static/js/pages/home-nav.js
  - static/js/pages/home-idle-motion.js
  - static/js/pages/statistics-reveal.js
  - static/js/pages/pager-scroll-story.js
  - static/js/pages/influenza-burden.js
css:
  - static/css/flask-sync/home.css
---
{% extends "layouts/base.njk" %}

{% block main %}
<!-- 模块 0: GIF 开场动画（默认不显示、不下载；由 index-intro-gif.js 激活。
     无 JS / prefers-reduced-motion / 脚本加载失败时自动跳过，导航栏照常显示） -->
    <div class="intro-gif" id="intro-gif">
      <div class="intro-gif__stage">
        <img class="intro-gif__frame" alt="" data-gif-src="{{ basePath | default('') }}static/image/home/boot-animation.webp"
          data-duration="9200">
      </div>
      <p class="intro-gif__loading">Loading…</p>
      <button type="button" class="intro-gif__skip" id="intro-gif-skip">skip<span
          aria-hidden="true">→</span></button>
    </div>


    <!-- 模块 1: Hero 标题页（板块 1：ECHO 品牌构图，由 webp 组件拼装） -->
    <section id="hero" class="presentation-section yeast-screen yeast-screen--hero" data-title="Home">
      <h1 class="sr-only">ECHO Yeast — an engineered <i>Saccharomyces cerevisiae</i> biosensor for influenza A (H1N1) virus</h1>
      <div class="echo-stage" aria-label="ECHO = Engineered Cellular Host, Observation of viral signals">
        <img class="echo-art echo-art--logo"
          src="{{ basePath | default('') }}static/image/home/01-hero-echo-logo.png" alt="ECHO">
        <img class="echo-art echo-art--dash-a" alt="" aria-hidden="true"
          src="{{ basePath | default('') }}static/image/home/shared-yellow-dash-a.webp">
        <img class="echo-art echo-art--dash-b" alt="" aria-hidden="true"
          src="{{ basePath | default('') }}static/image/home/shared-yellow-dash-b.webp">
        <img class="echo-art echo-art--tagline" alt="ECHO = Engineered Cellular Host, Observation of viral signals"
          src="{{ basePath | default('') }}static/image/home/shared-blue-curve.png">
        <img class="echo-art echo-art--mascot" alt="EchoYeast, the yeast mascot"
          src="{{ basePath | default('') }}static/image/home/01-hero-mascot.webp">
        <img class="echo-art echo-art--wave" alt="" aria-hidden="true"
          src="{{ basePath | default('') }}static/image/home/shared-wave-1.png">
      </div>
    </section>

    
    <section id="influenza-burden" class="presentation-section yeast-screen" data-title="Influenza burden">
      <h2 class="sr-only">About 1 in 12 people worldwide is infected by influenza A every year</h2>
      <div class="art-stage art-stage--influenza-burden">
        <!-- 自绘背景层（无素材、纯 CSS/SVG）：淡淡的数据网格 + 计数器区域柔光 +
             一枚 12 刻度的虚线环（呼应「每 12 人 1 人」）。极缓慢的漂移/呼吸只动
             transform，prefers-reduced-motion 下停止；整层在内容之下且不接收点击。 -->
        <div class="burden-backdrop" aria-hidden="true">
          <span class="burden-backdrop__grid"></span>
          <span class="burden-backdrop__glow"></span>
          <svg class="burden-backdrop__ring" viewBox="0 0 100 100" fill="none" focusable="false">
            <circle cx="50" cy="50" r="44" stroke="rgba(76,157,211,0.55)" stroke-width="0.8"
              stroke-dasharray="1.2 5.5" stroke-linecap="round"></circle>
            <circle cx="50" cy="50" r="34" stroke="rgba(76,157,211,0.3)" stroke-width="0.55"
              stroke-dasharray="1.2 8" stroke-linecap="round"></circle>
            <circle cx="50" cy="6.5" r="2.1" transform="rotate(0 50 50)"
              fill="rgba(76,157,211,0.7)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(30 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(60 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(90 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(120 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(150 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(180 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(210 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(240 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(270 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(300 50 50)"
              fill="rgba(76,157,211,0.38)"></circle><circle cx="50" cy="6.5" r="2.1" transform="rotate(330 50 50)"
              fill="rgba(76,157,211,0.38)"></circle>
          </svg>
          
          <img fetchpriority="low" loading="lazy" class="burden-backdrop__virus"
            src="{{ basePath | default('') }}static/image/home/02-virus.png" alt="" aria-hidden="true"
            width="1600" height="1600" decoding="async">
        </div>

        
        <img fetchpriority="low" class="burden-hero"
          src="{{ basePath | default('') }}static/image/home/02-burden-patient.png"
          alt="" aria-hidden="true" width="1600" height="1600" loading="lazy" decoding="async">

        <p class="burden-eyebrow">Influenza A · every year</p>

        <p class="burden-lead">
          <span class="burden-lead__num">1 in 12</span>
          <span class="burden-lead__copy">people worldwide are infected by influenza A every year</span>
        </p>

        
        <ul class="burden-grid" aria-hidden="true">
          <li class="burden-grid__dot" style="z-index: 12"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-{{ 'yeast-sick' if i == 11 else 'yeast-healthy' }}.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 11"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 10"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 9"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 8"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 7"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 6"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 5"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 4"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 3"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot" style="z-index: 2"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-healthy.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li><li class="burden-grid__dot is-lit" style="z-index: 1"><img fetchpriority="low"
              class="burden-grid__yeast"
              src="{{ basePath | default('') }}static/image/home/02-yeast-sick.png"
              alt="" width="1600" height="1600" loading="lazy" decoding="async"></li>
        </ul>

        <!-- 实时感染计数器（无 JS 时读的是「每年 660,000,000 人」这一静态事实） -->
        <div class="burden-counter">
          <p class="burden-counter__label" data-burden-label>Every year</p>
          <p class="burden-counter__value" data-burden-value>660,000,000</p>
          <p class="burden-counter__unit" data-burden-unit>people catch influenza A</p>
          <div class="burden-counter__track" aria-hidden="true">
            <span class="burden-counter__tick"></span>
          </div>
          <p class="burden-counter__rate">≈ 21 every second</p>
        </div>
        <p class="sr-only">Approximately 21 people are infected with influenza A every second — about
          660 million each year, based on WHO estimates.</p>

        <p class="burden-years-caption">Share of the world population</p>
        <ul class="burden-years">
          <li class="burden-year"><span class="burden-year__label">2023</span><span class="burden-year__val">8.19%</span></li><li class="burden-year"><span class="burden-year__label">2024</span><span class="burden-year__val">8.11%</span></li><li class="burden-year"><span class="burden-year__label">2025</span><span class="burden-year__val">8.03%</span></li>
        </ul>

        <p class="burden-note">Estimate: WHO ~1 billion seasonal influenza cases each year × influenza A share of
          positives (66%, WHO South-East Asia Region, 2025) ÷ UN world population for that year; that is also
          ≈ 21 new infections every second. Sources: WHO Influenza (seasonal) fact sheet, 28 Feb 2025;
          WHO Seasonal influenza – Global situation, 10 Dec 2025; UN World Population Prospects via World Bank.</p>
      </div>
    </section>

    <!-- 模块 2: 人类实践（human-practices） -->
    <section id="human-practices" class="presentation-section yeast-screen" data-title="Human practices">
      <h2 class="sr-only">Virus detections by subtype reported to FluNet, 21 October 2022 to 21 August 2026</h2>
      
      <div class="art-stage art-stage--human-practices">
        <!-- <img class="art art--human-practices-wave" src="{{ basePath | default('') }}static/image/home/shared-wave-1.png" alt="" aria-hidden="true"> -->
        
        <img fetchpriority="low" loading="lazy" class="art art--human-practices-title" src="{{ basePath | default('') }}static/image/home/03-human-practices-chart-title.png"
          alt="Virus detections by subtype reported to FluNet, 21 October 2022 to 21 August 2026">
        
        <img fetchpriority="low" loading="lazy" class="art art--human-practices-chart" src="{{ basePath | default('') }}static/image/home/03-human-practices-chart.png" alt="Line chart of influenza detections by subtype">
        <img fetchpriority="low" loading="lazy" class="art art--human-practices-mascot" src="{{ basePath | default('') }}static/image/home/03-human-practices-mascot-cape.webp" alt="EchoYeast peeking out at the bottom right">
        
        <!-- 2026-10-21：删去横轴标题「Week start date」，同位置改为数据来源标注（WHO FluNet） -->
        <p class="art art--human-practices-source" lang="en">
          Data source: <a href="https://www.who.int/toolkits/flunet/" target="_blank" rel="noopener noreferrer">WHO FluNet</a>,
          Global Influenza Programme
        </p>
        <p class="art art--human-practices-legend-subtypes art-legend" lang="en">Influenza subtypes</p>
        <p class="art art--human-practices-legend-h1n1 art-legend" lang="en"><span class="art-legend__swatch" style="--swatch:#acdaf2" aria-hidden="true"></span>A(H1N1)pdm09</p>
        <p class="art art--human-practices-legend-pos art-legend" lang="en"><span class="art-legend__swatch" style="--swatch:#f0a609" aria-hidden="true"></span>Influenza percent positive</p>
      </div>
    </section>

    
    <section id="passive-to-active" class="presentation-section yeast-screen" data-title="Passive to active">
      <h2 class="sr-only">From passive detection to active monitoring</h2>
      <div class="pta-stage">
        <figure class="pta-figure">
          <img fetchpriority="low" src="https://static.igem.wiki/teams/6373/wiki/icon/second-section/passive-detection-swab.avif"
            alt="EchoYeast having a throat swab at a clinic — an illustration of passive detection"
            width="1625" height="1653" loading="lazy" decoding="async">
        </figure>
        <div class="pta-thread" aria-hidden="true"></div>
        <div class="pta-copy" lang="en">
          <p class="pta-copy__eyebrow reveal">Why active detection</p>
          <h3 class="pta-copy__title reveal">Every existing test waits for you to feel sick</h3>
          <p class="pta-copy__body reveal">Passive detection begins only after symptoms appear — a clinic
            visit, a swab, laboratory confirmation. We are not trying to outperform these methods; we want
            to change where detection begins: from waiting rooms to the air we share.</p>
        </div>
      </div>
    </section>

    <!-- 模块 3: 结果（statistics） -->
    <section id="statistics" class="presentation-section yeast-screen" data-title="Results">
      <h2 class="sr-only">Detection methods: qPCR / ELISA / CGIS</h2>
      
      <div class="art-stage art-stage--statistics">
        <!-- 英文小标题：进入该屏时由 statistics-reveal.js 触发「右先左后」逐词下落；
             无 JS 时静态可见（脚本只加类，不做默认隐藏） -->
        <p class="statistics-caption" lang="en">Contemporary popular methods for detecting H1N1 influenza</p>
        <!-- <img fetchpriority="low" loading="lazy" class="art art--statistics-cloud" src="{{ basePath | default('') }}static/image/home/04-statistics-cloud.webp" alt="" aria-hidden="true"> -->
        <img fetchpriority="low" loading="lazy" class="art art--statistics-hill" src="{{ basePath | default('') }}static/image/home/04-statistics-hill.webp" alt="" aria-hidden="true">
        <img loading="lazy" class="art art--statistics-qpcr" data-critical src="{{ basePath | default('') }}static/image/home/04-statistics-circle-qpcr.webp" alt="qPCR">
        <img loading="lazy" class="art art--statistics-elisa" data-critical src="{{ basePath | default('') }}static/image/home/04-statistics-circle-elisa.webp" alt="ELISA">
        <img loading="lazy" class="art art--statistics-cgis" data-critical id="statistics-cgis" src="{{ basePath | default('') }}static/image/home/04-statistics-circle-cgis.webp" alt="CGIS">
        <img loading="lazy" class="art art--statistics-arc" data-critical src="{{ basePath | default('') }}static/image/home/04-statistics-dashed-arc.webp" alt="" aria-hidden="true">
        
        <img loading="lazy" class="art art--statistics-link" data-critical src="{{ basePath | default('') }}static/image/home/04-statistics-dashed-arc.webp"
          alt="" aria-hidden="true" decoding="async">
        <img fetchpriority="low" loading="lazy" class="art art--statistics-bulb" src="{{ basePath | default('') }}static/image/home/04-statistics-bulb.webp" alt="" aria-hidden="true">
        <img fetchpriority="low" loading="lazy" class="art art--statistics-mascot" src="{{ basePath | default('') }}static/image/home/04-statistics-mascot-thinking.webp" alt="EchoYeast thinking about detection methods">
        <img fetchpriority="low" loading="lazy" class="art art--statistics-sparkle" src="{{ basePath | default('') }}static/image/home/shared-sparkle.webp" alt="" aria-hidden="true">
        <!-- CGIS 点击提示（箭头 + Click here）：由 statistics-reveal.js 定位到 CGIS 圆正上方，
             点击展开后移除；无 JS / 未进入该屏时不显示 -->
        <div class="statistics-hint" aria-hidden="true">
          <div class="statistics-hint__inner">
            <span class="statistics-hint__label">Click here</span>
            <svg class="statistics-hint__arrow" viewBox="0 0 24 46" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M12 3 C 12 14, 12 22, 12 33" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 7.5"></path>
              <path d="M4.5 29 L12 41.5 L19.5 29" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
        
        <div class="method-info method-info--qpcr">
          <p class="method-info__title">qPCR <small>Nucleic acid test</small></p>
          <p class="method-info__pro">＋ Highest sensitivity &amp; accuracy, quantitative — the reference standard</p>
          <p class="method-info__con">－ Needs lab equipment &amp; trained staff, ~1–2 h</p>
        </div>
        <div class="method-info method-info--elisa">
          <p class="method-info__title">ELISA <small>Antigen / protein test</small></p>
          <p class="method-info__pro">＋ High throughput &amp; lower cost, good for batch screening</p>
          <p class="method-info__con">－ Less sensitive than qPCR, needs a reader &amp; more time</p>
        </div>
        <div class="method-info method-info--cgis">
          <p class="method-info__title">CGIS <small>Colloidal gold strip</small></p>
          <p class="method-info__pro">＋ On-site result in 10–15 min, portable, no instruments</p>
          <p class="method-info__con">－ Limited sensitivity &amp; result uncertainty, needs confirmatory testing</p>
        </div>
      </div>
    </section>

    <!-- 模块 4: 安全（safety） -->
    <section id="safety" class="presentation-section yeast-screen" data-title="Safety">
      <h2 class="sr-only">Influenza A Virus Biosensor Based on Engineered Yeast</h2>
      
      <div class="art-stage art-stage--safety">
        
        <img fetchpriority="low" loading="lazy" class="art art--safety-sky" src="{{ basePath | default('') }}static/image/home/05-safety-sky.webp"
          alt="" aria-hidden="true" decoding="async">
        <img fetchpriority="low" loading="lazy" class="art art--safety-cloud" src="{{ basePath | default('') }}static/image/home/shared-cloud-1.webp" alt="" aria-hidden="true">
        <!-- <img fetchpriority="low" loading="lazy" class="art art--safety-curve" src="{{ basePath | default('') }}static/image/home/shared-blue-curve.png" alt="" aria-hidden="true"> -->
        <img fetchpriority="low" loading="lazy" class="art art--safety-mascot" src="{{ basePath | default('') }}static/image/home/05-safety-mascot-flying.webp" alt="EchoYeast flying in a cape">
        
        <img fetchpriority="low" loading="lazy" class="art art--safety-title" src="{{ basePath | default('') }}static/image/home/05-safety-title.png"
          alt="Influenza A Virus Biosensor Based on Engineered Yeast">
        <img fetchpriority="low" loading="lazy" class="art art--safety-sparkle" src="{{ basePath | default('') }}static/image/home/shared-sparkle.webp" alt="" aria-hidden="true">
        <img fetchpriority="low" loading="lazy" class="art art--safety-sparkle art--safety-star-a" src="{{ basePath | default('') }}static/image/home/shared-sparkle.webp"
          alt="" aria-hidden="true" decoding="async">
        <img fetchpriority="low" loading="lazy" class="art art--safety-sparkle art--safety-star-b" src="{{ basePath | default('') }}static/image/home/shared-sparkle.webp"
          alt="" aria-hidden="true" decoding="async">
      </div>
    </section>

    <!-- 模块 5: 背景（public-health） -->
    <section id="public-health" class="presentation-section yeast-screen" data-title="Background">
      <h2 class="sr-only">Can We Build a Living Sensor That Directly Responds to Viral Signals?</h2>
      
      <div class="art-stage art-stage--public-health">
        
        <img fetchpriority="low" loading="lazy" class="art art--public-health-title" src="{{ basePath | default('') }}static/image/home/06-public-health-title.png"
          alt="Can We Build a Living Sensor That Directly Responds to Viral Signals?">
        <img fetchpriority="low" loading="lazy" class="art art--public-health-petri" src="{{ basePath | default('') }}static/image/home/06-public-health-petri-dish.webp" alt="" aria-hidden="true">
        <img fetchpriority="low" loading="lazy" class="art art--public-health-virus" src="{{ basePath | default('') }}static/image/home/06-public-health-virus-cluster.webp" alt="" aria-hidden="true">
        <img fetchpriority="low" loading="lazy" class="art art--public-health-mascot" src="{{ basePath | default('') }}static/image/home/06-public-health-mascot-magnifier.webp" alt="EchoYeast examining a virus through a magnifying glass">
      </div>
    </section>

    <!-- 模块 6: 设计（project-intro） -->
    <section id="project-intro" class="presentation-section yeast-screen" data-title="Design">
      <h2 class="sr-only">WHY EHCO Yeast?</h2>
      
      <div class="art-stage art-stage--project-intro">
        <img fetchpriority="low" loading="lazy" class="art art--project-intro-cloud" src="{{ basePath | default('') }}static/image/home/shared-cloud-1.webp" alt="" aria-hidden="true">
        
        <img fetchpriority="low" loading="lazy" class="art art--project-intro-title" src="{{ basePath | default('') }}static/image/home/07-project-intro-title.png"
          alt="WHY EHCO Yeast?">
        <!-- 文字条：3 排 × 每排 2 条 ｜ 椭圆描边 + 边缘渐隐 + 流动轮播
             位置/大小/速度 → static/css/index.css 搜「project-intro 文字条」
             每排的 .intro-pills__group 出现两次（第二份 aria-hidden）用于无缝循环，删掉会跳帧 -->
        <div class="intro-pills">
          <div class="intro-pills__row">
            <div class="intro-pills__track">
              <div class="intro-pills__group">
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Low-cost cultivation</span></span>
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Native eukaryotic signal transduction network</span></span>
              </div>
              <div class="intro-pills__group" aria-hidden="true">
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Low-cost cultivation</span></span>
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Native eukaryotic signal transduction network</span></span>
              </div>
            </div>
          </div>
          <div class="intro-pills__row">
            <div class="intro-pills__track">
              <div class="intro-pills__group">
                <span class="intro-pill"><span class="intro-pill__text" lang="en">High biosafety level</span></span>
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Strong environmental tolerance</span></span>
              </div>
              <div class="intro-pills__group" aria-hidden="true">
