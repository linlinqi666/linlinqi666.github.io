---
permalink: "index.html"
title: "iGEM SZPU-2026 - 首页"
lang: "zh-CN"
htmlClass: "home-scroll-snap"
footer: false
headExtraPartial: "head-extra/index.njk"
bodyClass: "home-page"
mainClass: "long-page"
js:
  - static/js/components/executive-summary-animation.js
  - static/js/components/index-intro-gif.js
  - static/js/pages/home-nav.js
  - static/js/pages/home-idle-motion.js
  - static/js/pages/statistics-reveal.js
  - static/js/pages/dbtl-pump.js
  - static/js/pages/influenza-burden.js
---

{% extends "layouts/base.njk" %}

{% block main %}
<!-- 模块 0: GIF 开场动画（默认不显示、不下载；由 index-intro-gif.js 激活。
     无 JS / prefers-reduced-motion / 脚本加载失败时自动跳过，导航栏照常显示） -->
    <div class="intro-gif" id="intro-gif">
      <div class="intro-gif__stage">
        <img class="intro-gif__frame" alt="" data-gif-src="static/image/Animation/index/gif/boot%20animation.GIF"
          data-duration="9200">
      </div>
      <p class="intro-gif__loading">Loading…</p>
      <button type="button" class="intro-gif__skip" id="intro-gif-skip">跳过动画<span
          aria-hidden="true">→</span></button>
    </div>

<!-- 首页动画屏顺序（2026-10-03 调整）：1 首页(hero) → 2 甲流负担(influenza-burden) → 3 人类实践(human-practices) → 4 结果(statistics) → 5 安全(safety) → 6 背景(public-health) → 7 设计(project-intro) → 8 构建与测试(dbtl-cycle) -->
    <!-- 模块 1: Hero 标题页（板块 1：ECHO 品牌构图，由 webp 组件拼装） -->
    <section id="hero" class="presentation-section yeast-screen yeast-screen--hero" data-title="首页">
      <h1 class="sr-only">ECHO Yeast — 工程化酿酒酵母 H1N1 流感病毒生物传感器</h1>
      <div class="echo-stage" aria-label="ECHO = Engineered Cellular Host, Observation of viral signals">
        <img class="echo-art echo-art--logo"
          src="static/image/Animation/index/webp/first-section/hero-echo-logo.png" alt="ECHO">
        <img class="echo-art echo-art--dash-a" alt="" aria-hidden="true"
          src="static/image/Animation/index/webp/shared/shared-yellow-dash-a.webp">
        <img class="echo-art echo-art--dash-b" alt="" aria-hidden="true"
          src="static/image/Animation/index/webp/shared/shared-yellow-dash-b.webp">
        <img class="echo-art echo-art--tagline" alt="ECHO = Engineered Cellular Host, Observation of viral signals"
          src="static/image/Animation/index/webp/shared/shared-blue-curve.png">
        <img class="echo-art echo-art--mascot" alt="EchoYeast 酵母吉祥物"
          src="static/image/Animation/index/webp/first-section/hero-mascot.webp">
        <img class="echo-art echo-art--wave" alt="" aria-hidden="true"
          src="static/image/Animation/index/webp/shared/shared-wave-1.png">
      </div>
    </section>

    <!-- 模块 1.5: 甲流负担（influenza-burden）—— 数据沉浸屏（2026-10-03 v2 重做）
         主体是「实时感染计数器」：按 WHO 口径（每年约 10 亿例季节性流感 × 甲型占比 66%），
         折合每年约 6.6 亿、每秒约 21 人感染甲流；页面打开起数字持续跳动，读者停留的每一秒
         都在涨——这是本屏"持续抓住视觉"的核心；辅以 12 席位网格（1 格亮蓝 = 每 12 人 1 人）、
         2023–2025 三年占总人口比例（表格式右栏）与来源注脚。
         ★ 降级铁律：标记里默认写的是「每年 660,000,000 人感染」，无障碍/无 JS 读到的是这版
           静态事实；实时计数器由 influenza-burden.js 接管后才换成「since you opened this page」
           并持续跳动（同时把跳动数字标记 aria-hidden，旁边提供静态的无障碍句子）。
         prefers-reduced-motion / 无 JS / 无 WAAPI → 不接管，保持静态年值。 -->
    <section id="influenza-burden" class="presentation-section yeast-screen" data-title="甲流负担">
      <h2 class="sr-only">About 1 in 12 people worldwide is infected by influenza A every year</h2>
      <div class="art-stage art-stage--influenza-burden">
        <!-- 自绘背景层（无素材、纯 CSS/SVG）：淡淡的数据网格 + 计数器区域柔光 +
             一枚 12 刻度的虚线环（呼应「每 12 人 1 人」）。极缓慢的漂移/呼吸只动
             transform，prefers-reduced-motion 下停止；整层在内容之下且不接收点击。 -->
        <div class="burden-backdrop" aria-hidden="true">
          <span class="burden-backdrop__grid"></span>
          <span class="burden-backdrop__glow"></span>
          <svg class="burden-backdrop__ring" viewBox="0 0 100 100" fill="none" focusable="false">
            <circle cx="50" cy="50" r="44" stroke="rgba(76,157,211,0.55)" stroke-width="0.8"
              stroke-dasharray="1.2 5.5" stroke-linecap="round"></circle>
            <circle cx="50" cy="50" r="34" stroke="rgba(76,157,211,0.3)" stroke-width="0.55"
              stroke-dasharray="1.2 8" stroke-linecap="round"></circle>
            {% for i in range(0, 12) %}<circle cx="50" cy="6.5" r="2.1" transform="rotate({{ i * 30 }} 50 50)"
              fill="{{ 'rgba(76,157,211,0.7)' if i == 0 else 'rgba(76,157,211,0.38)' }}"></circle>{% endfor %}
          </svg>
          <!-- 2026-10-06：甲流病毒坐在右下角虚线环的角落里（美工 virus.png 透明图）。
               只做极缓慢的上下浮动（transform-only），离屏随 section 停表。 -->
          <img class="burden-backdrop__virus"
            src="static/image/Animation/index/webp/second-section/virus.png" alt="" aria-hidden="true"
            width="1600" height="1600" decoding="async">
        </div>

        <p class="burden-eyebrow">Influenza A · every year</p>

        <p class="burden-lead">
          <span class="burden-lead__num">1 in 12</span>
          <span class="burden-lead__copy">people worldwide are infected by influenza A every year</span>
        </p>

        <!-- 12 席位：每格代表人口里的 1 人，1 格亮蓝 -->
        <ul class="burden-grid" aria-hidden="true">
          {% for i in range(0, 12) %}<li class="burden-grid__dot{{ ' is-lit' if i == 0 else '' }}"></li>{% endfor %}
        </ul>

        <!-- 实时感染计数器（无 JS 时读的是「每年 660,000,000 人」这一静态事实） -->
        <div class="burden-counter">
          <p class="burden-counter__label" data-burden-label>Every year</p>
          <p class="burden-counter__value" data-burden-value>660,000,000</p>
          <p class="burden-counter__unit" data-burden-unit>people catch influenza A</p>
          <div class="burden-counter__track" aria-hidden="true">
            <span class="burden-counter__tick"></span>
          </div>
          <p class="burden-counter__rate">≈ 21 every second</p>
        </div>
        <p class="sr-only">Approximately 21 people are infected with influenza A every second — about
          660 million each year, based on WHO estimates.</p>

        <p class="burden-years-caption">Share of the world population</p>
        <ul class="burden-years">
          {% for y in [{ y: '2023', v: '8.19%' }, { y: '2024', v: '8.11%' }, { y: '2025', v: '8.03%' }] %}<li class="burden-year"><span class="burden-year__label">{{ y.y }}</span><span class="burden-year__val">{{ y.v }}</span></li>{% endfor %}
        </ul>

        <p class="burden-note">Estimate: WHO ~1 billion seasonal influenza cases each year × influenza A share of
          positives (66%, WHO South-East Asia Region, 2025) ÷ UN world population for that year; that is also
          ≈ 21 new infections every second. Sources: WHO Influenza (seasonal) fact sheet, 28 Feb 2025;
          WHO Seasonal influenza – Global situation, 10 Dec 2025; UN World Population Prospects via World Bank.</p>
      </div>
    </section>

    <!-- 模块 2: 人类实践（human-practices） -->
    <section id="human-practices" class="presentation-section yeast-screen" data-title="人类实践">
      <h2 class="sr-only">Virus detections by subtype reported to FluNet, 21 October 2022 to 21 August 2026</h2>
      <!-- human-practices「FluNet 图表」 ｜ 对照成品图：对话归档/2026-09/2026-09-22-homepage-assembly/mockups/96673fa9ecf228f6acfe63f4ef7af4a2.65a2a71e09.jpg
           微调大小与位置 → static/css/index.css 搜「手动微调区」里的 art-stage--human-practices 段 -->
      <div class="art-stage art-stage--human-practices">
        <!-- <img class="art art--human-practices-wave" src="static/image/Animation/index/webp/shared/shared-wave-1.png" alt="" aria-hidden="true"> -->
        <!-- 2026-10-06e：标题改用美工字图（8.png 紧裁）；轴标签/图例仍为真文本 -->
        <img class="art art--human-practices-title" src="static/image/Animation/index/webp/third-section/human-practices-chart-title.png"
          alt="Virus detections by subtype reported to FluNet, 21 October 2022 to 21 August 2026">
        <!-- 2026-10-06d：5 张字体插图 img 全部移除——4 张内容配错（见下注），chart-title 虽内容正确
             但与 HTML 标题同位重复（方形图内文字落图中央成重影）。全部由真文本渲染替代。 -->
        <img class="art art--human-practices-chart" src="static/image/Animation/index/webp/third-section/human-practices-chart.png" alt="流感亚型检测量折线图">
        <img class="art art--human-practices-mascot" src="static/image/Animation/index/webp/third-section/human-practices-mascot-cape.webp" alt="EchoYeast 在右下角探出头">
        <!-- 2026-10-06d：删去 4 张内容配错的字体插图 png（axis-label 实为 WHY EHCO Yeast?、
             legend-subtypes/h1n1 均为 Can We Build a Living Sensor…、legend-positive 为另一句标题）；
             图例与横轴标题保留下方 HTML 文本（同款圆体、更清晰）。chart-title.png 内容正确保留。 -->
        <p class="art art--human-practices-axis art-title-text" lang="en">Week start date</p>
        <p class="art art--human-practices-legend-subtypes art-legend" lang="en">Influenza subtypes</p>
        <p class="art art--human-practices-legend-h1n1 art-legend" lang="en"><span class="art-legend__swatch" style="--swatch:#acdaf2" aria-hidden="true"></span>A(H1N1)pdm09</p>
        <p class="art art--human-practices-legend-pos art-legend" lang="en"><span class="art-legend__swatch" style="--swatch:#f0a609" aria-hidden="true"></span>Influenza percent positive</p>
      </div>
    </section>

    <!-- 模块 3: 结果（statistics） -->
    <section id="statistics" class="presentation-section yeast-screen" data-title="结果">
      <h2 class="sr-only">Detection methods: qPCR / ELISA / CGIS</h2>
      <!-- statistics「qPCR / ELISA / CGIS」 ｜ 对照成品图：对话归档/2026-09/2026-09-22-homepage-assembly/mockups/2c38d1be8698c07ee4679dbe7058ae5f.733d81e9d9.jpg
           微调大小与位置 → static/css/index.css 搜「手动微调区」里的 art-stage--statistics 段 -->
      <div class="art-stage art-stage--statistics">
        <!-- 英文小标题：进入该屏时由 statistics-reveal.js 触发「右先左后」逐词下落；
             无 JS 时静态可见（脚本只加类，不做默认隐藏） -->
        <p class="statistics-caption" lang="en">Contemporary popular methods for detecting H1N1 influenza</p>
        <!-- <img class="art art--statistics-cloud" src="static/image/Animation/index/webp/fourth-section/statistics-cloud.webp" alt="" aria-hidden="true"> -->
        <img class="art art--statistics-hill" src="static/image/Animation/index/webp/fourth-section/statistics-hill.webp" alt="" aria-hidden="true">
        <img class="art art--statistics-qpcr" src="static/image/Animation/index/webp/fourth-section/statistics-circle-qpcr.webp" alt="qPCR">
        <img class="art art--statistics-elisa" src="static/image/Animation/index/webp/fourth-section/statistics-circle-elisa.webp" alt="ELISA">
        <img class="art art--statistics-cgis" id="statistics-cgis" src="static/image/Animation/index/webp/fourth-section/statistics-circle-cgis.webp" alt="CGIS">
        <img class="art art--statistics-arc" src="static/image/Animation/index/webp/fourth-section/statistics-dashed-arc.webp" alt="" aria-hidden="true">
        <!-- 2026-10-06f：ELISA→qPCR 第二段连线。
             2026-10-06i：原为自绘 SVG，弧向与第一条不对称 → 改为复用同一切图
             statistics-dashed-arc.webp 并 rotate(180deg)，即第一条弧绕中心翻转 180°，
             与 CGIS–ELISA 弧构成 S 形链；z-index 1 压在两圆之下，端头被圆挡住
             读作"相连"。揭示顺序：CGIS 弧画出 → ELISA 落位 → 本线擦出 → qPCR 落位
             （statistics-reveal.js）。降级红线：无 JS / reduced-motion 静态可见。 -->
        <img class="art art--statistics-link" src="static/image/Animation/index/webp/fourth-section/statistics-dashed-arc.webp"
          alt="" aria-hidden="true" decoding="async">
        <img class="art art--statistics-bulb" src="static/image/Animation/index/webp/fourth-section/statistics-bulb.webp" alt="" aria-hidden="true">
        <img class="art art--statistics-mascot" src="static/image/Animation/index/webp/fourth-section/statistics-mascot-thinking.webp" alt="EchoYeast 思考检测方法">
        <img class="art art--statistics-sparkle" src="static/image/Animation/index/webp/shared/shared-sparkle.webp" alt="" aria-hidden="true">
        <!-- CGIS 点击提示（箭头 + Click here）：由 statistics-reveal.js 定位到 CGIS 圆正上方，
             点击展开后移除；无 JS / 未进入该屏时不显示 -->
        <div class="statistics-hint" aria-hidden="true">
          <div class="statistics-hint__inner">
            <span class="statistics-hint__label">Click here</span>
            <svg class="statistics-hint__arrow" viewBox="0 0 24 46" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M12 3 C 12 14, 12 22, 12 33" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 7.5"></path>
              <path d="M4.5 29 L12 41.5 L19.5 29" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
        <!-- 三方法信息条（2026-10-05）：三圆揭示完成后，移入任一圆 → 从圆右侧「擦除」展开
             蓝底白字条（优势/劣势），移出收回；揭示完成前不可见（由 statistics-reveal.js
             加 js-methods-armed 收起 + is-open 展开）。
             无 JS / prefers-reduced-motion：三条静态可见（默认 CSS 不做隐藏，降级红线）。
             文案出处：首页逻辑.docx Part 1（qPCR/ELISA 精准但依赖设备实验室人员、
             CGIS 现场快检）；经 CDC「Overview of Influenza Testing Methods / RIDT Guidance」
             与 MDPI 2025 综述外部确证——docx 中「CGIS 假阳性高」按 CDC 口径修正为
             「灵敏度有限（易假阴性）、结果不确定性高」（详见交付文档）。 -->
        <div class="method-info method-info--qpcr">
          <p class="method-info__title">qPCR <small>Nucleic acid test</small></p>
          <p class="method-info__pro">＋ Highest sensitivity &amp; accuracy, quantitative — the reference standard</p>
          <p class="method-info__con">－ Needs lab equipment &amp; trained staff, ~1–2 h</p>
        </div>
        <div class="method-info method-info--elisa">
          <p class="method-info__title">ELISA <small>Antigen / protein test</small></p>
          <p class="method-info__pro">＋ High throughput &amp; lower cost, good for batch screening</p>
          <p class="method-info__con">－ Less sensitive than qPCR, needs a reader &amp; more time</p>
        </div>
        <div class="method-info method-info--cgis">
          <p class="method-info__title">CGIS <small>Colloidal gold strip</small></p>
          <p class="method-info__pro">＋ On-site result in 10–15 min, portable, no instruments</p>
          <p class="method-info__con">－ Limited sensitivity &amp; result uncertainty, needs confirmatory testing</p>
        </div>
      </div>
    </section>

    <!-- 模块 4: 安全（safety） -->
    <section id="safety" class="presentation-section yeast-screen" data-title="安全">
      <h2 class="sr-only">Influenza A Virus Biosensor Based on Engineered Yeast</h2>
      <!-- safety「Influenza A Virus Biosensor」 ｜ 对照成品图：对话归档/2026-09/2026-09-22-homepage-assembly/mockups/b6dd40228602e3596ff162aa41b47b4c.c2d33725d0.jpg
           微调大小与位置 → static/css/index.css 搜「手动微调区」里的 art-stage--safety 段 -->
      <div class="art-stage art-stage--safety">
        <!-- 2026-10-07：按设计稿补齐「上部波浪 + 3 颗星」。上波 = 现有底部云波
             shared-cloud-1.webp 垂直翻转（scaleY(-1)），同源同宽必对称；星星复用
             shared-sparkle.webp，左上/右上各一颗（第三颗是原有的那颗）。 -->
        <img class="art art--safety-sky" src="static/image/Animation/index/webp/fifth-section/safety-sky.webp"
          alt="" aria-hidden="true" decoding="async">
        <img class="art art--safety-cloud" src="static/image/Animation/index/webp/shared/shared-cloud-1.webp" alt="" aria-hidden="true">
        <!-- <img class="art art--safety-curve" src="static/image/Animation/index/webp/shared/shared-blue-curve.png" alt="" aria-hidden="true"> -->
        <img class="art art--safety-mascot" src="static/image/Animation/index/webp/fifth-section/safety-mascot-flying.webp" alt="EchoYeast 披风飞行">
        <!-- 2026-10-06e：标题改用美工字图（20.png 紧裁）；SR 文本见 section 内 h2.sr-only -->
        <img class="art art--safety-title" src="static/image/Animation/index/webp/fifth-section/safety-title.png"
          alt="Influenza A Virus Biosensor Based on Engineered Yeast">
        <img class="art art--safety-sparkle" src="static/image/Animation/index/webp/shared/shared-sparkle.webp" alt="" aria-hidden="true">
        <img class="art art--safety-sparkle art--safety-star-a" src="static/image/Animation/index/webp/shared/shared-sparkle.webp"
          alt="" aria-hidden="true" decoding="async">
        <img class="art art--safety-sparkle art--safety-star-b" src="static/image/Animation/index/webp/shared/shared-sparkle.webp"
          alt="" aria-hidden="true" decoding="async">
      </div>
    </section>

    <!-- 模块 5: 背景（public-health） -->
    <section id="public-health" class="presentation-section yeast-screen" data-title="背景">
      <h2 class="sr-only">Can We Build a Living Sensor That Directly Responds to Viral Signals?</h2>
      <!-- public-health「Can We Build a Living Sensor」 ｜ 对照成品图：对话归档/2026-09/2026-09-22-homepage-assembly/mockups/50314a3b2c87cfe13cd2dfd90a295494.2e5af09548.jpg
           微调大小与位置 → static/css/index.css 搜「手动微调区」里的 art-stage--public-health 段 -->
      <div class="art-stage art-stage--public-health">
        <!-- 2026-10-06e：标题改用美工字图（12.png 紧裁）；SR 文本见 section 内 h2.sr-only -->
        <img class="art art--public-health-title" src="static/image/Animation/index/webp/sixth-section/public-health-title.png"
          alt="Can We Build a Living Sensor That Directly Responds to Viral Signals?">
        <img class="art art--public-health-petri" src="static/image/Animation/index/webp/sixth-section/public-health-petri-dish.webp" alt="" aria-hidden="true">
        <img class="art art--public-health-virus" src="static/image/Animation/index/webp/sixth-section/public-health-virus-cluster.webp" alt="" aria-hidden="true">
        <img class="art art--public-health-mascot" src="static/image/Animation/index/webp/sixth-section/public-health-mascot-magnifier.webp" alt="EchoYeast 手持放大镜观察病毒">
      </div>
    </section>

    <!-- 模块 6: 设计（project-intro） -->
    <section id="project-intro" class="presentation-section yeast-screen" data-title="设计">
      <h2 class="sr-only">WHY EHCO Yeast?</h2>
      <!-- project-intro「WHY EHCO Yeast」 ｜ 对照成品图：对话归档/2026-09/2026-09-22-homepage-assembly/mockups/588dd796bfeb7b0a1c24a53b4213b4f6.01c3a629f8.jpg
           微调大小与位置 → static/css/index.css 搜「手动微调区」里的 art-stage--project-intro 段 -->
      <div class="art-stage art-stage--project-intro">
        <img class="art art--project-intro-cloud" src="static/image/Animation/index/webp/shared/shared-cloud-1.webp" alt="" aria-hidden="true">
        <!-- 2026-10-06e：标题改用美工字图（14.png 紧裁；EHCO 为原设计稿拼写，按原样保留）；
             SR 文本见 section 内 h2.sr-only -->
        <img class="art art--project-intro-title" src="static/image/Animation/index/webp/seventh-section/project-intro-title.png"
          alt="WHY EHCO Yeast?">
        <!-- 文字条：3 排 × 每排 2 条 ｜ 椭圆描边 + 边缘渐隐 + 流动轮播
             位置/大小/速度 → static/css/index.css 搜「project-intro 文字条」
             每排的 .intro-pills__group 出现两次（第二份 aria-hidden）用于无缝循环，删掉会跳帧 -->
        <div class="intro-pills">
          <div class="intro-pills__row">
            <div class="intro-pills__track">
              <div class="intro-pills__group">
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Low-cost cultivation</span></span>
                <span class="intro-pill"><span class="intro-pill__text" lang="en">Native eukaryotic signal transduction network</span></span>
