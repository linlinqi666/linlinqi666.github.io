{% block scripts %}
<script>
// 交互演示的数据载荷：与正文表格同源（static/data/dry-lab/model/model-docking.json）。
// 页面脚本 static/js/pages/model-game.js 以 defer 加载，执行时本变量已就绪。
window.MODEL_DOCKING_DATA = {{ modelDocking.client | dump | safe }};
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    // 移动端汉堡菜单切换
    const hamburgerMenu = document.getElementById('hamburger-menu');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenu = document.getElementById('mobile-menu');

    if (hamburgerMenu && mobileOverlay && mobileMenu) {
      hamburgerMenu.addEventListener('click', function (e) {
        e.stopPropagation();
        this.classList.toggle('active');
        mobileOverlay.classList.toggle('active');

        if (mobileOverlay.classList.contains('active')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });

      // 点击遮罩层关闭
      mobileOverlay.addEventListener('click', function (e) {
        if (e.target === mobileOverlay) {
          hamburgerMenu.classList.remove('active');
          mobileOverlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      });

      // 移动端下拉菜单切换
      const dropdownToggles = mobileMenu.querySelectorAll('.dropdown-toggle');
      dropdownToggles.forEach(function (toggle) {
        toggle.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          const parent = this.parentElement;
          parent.classList.toggle('dropdown-open');
        });
      });

      // 点击导航链接后关闭菜单
      const navLinks = mobileMenu.querySelectorAll('a:not(.dropdown-toggle)');
      navLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          hamburgerMenu.classList.remove('active');
          mobileOverlay.classList.remove('active');
          document.body.style.overflow = '';
        });
      });
    }

  });
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    new PageProgressBar().startAutoProgress();

  });
</script>
{% endblock %}
